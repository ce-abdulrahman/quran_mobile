<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/quran_widget_bg"
    android:padding="16dp">

    <!-- Top row: label pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/pill_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ ئایەتی ڕۆژ"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Arabic verse text -->
    <TextView
        android:id="@+id/widget_arabic_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:gravity="end|center_vertical"
        android:textDirection="rtl"
        android:ellipsize="end"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.4" />

    <!-- Kurdish translation -->
    <TextView
        android:id="@+id/widget_kurdish_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بە ناوی خوای بەخشەندەی میهرەبان"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:gravity="end"
        android:textDirection="rtl"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="4dp" />

    <!-- Surah name bottom -->
    <TextView
        android:id="@+id/widget_surah_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— الفاتحة : ١"
        android:textColor="#88FFFFFF"
        android:textSize="10sp"
        android:gravity="end"
        android:layout_marginTop="6dp" />

</LinearLayout>
