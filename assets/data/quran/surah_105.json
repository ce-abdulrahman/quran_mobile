[
    {
        "id": 6189,
        "ayah_number": 1,
        "text_uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ",
        "text_simple": null,
        "page_number": 1251,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12377,
                "language_code": "en",
                "content": "Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?<sup foot_note=197817>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12378,
                "language_code": "ku",
                "content": "ئایا نه‌تزانیووه (ئه‌ی پێغه‌مبه‌ر صلی الله علیه وسلم) په‌روه‌ردگارت چی کرد به‌خاوه‌ن فیله‌کان؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
