    {
        "id": 6130,
        "ayah_number": 5,
        "text_uthmani": "سَلَـٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ",
        "text_simple": null,
        "page_number": 1235,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12259,
                "language_code": "en",
                "content": "Peace it is<sup foot_note=197789>1<\/sup> until the emergence of dawn.",
                "is_active": true
            },
            {
                "id": 12260,
                "language_code": "ku",
                "content": "ئه‌و شه‌وه ئاسووده‌یی و ئاشتی و هێمنی و ڕه‌حمه‌ت و میهره‌بانیه‌، هه‌تا کاتی به‌ره‌به‌یان. پێغه‌مبه‌ر صلی الله علیه وسلم فه‌رموویه‌تی: (من قام لیلة القدر ایمانا واحتسبا غفر له ما تقدم من زنبه‌). واته‌: ئه‌وه‌ی شه‌وی قه‌در به‌خواپه‌رستی و یادی خوا بباته سه‌ر به ئیمان و باوه‌ڕی دامه‌زراوو به‌ته‌مابوونی پاداشت و ڕه‌حمه‌ت، خوای گه‌وره له هه‌موو گوناهانی ڕابردووی خۆش ده‌بێت. (بوخاری و موسلیم) ڕیوایه‌تیان کردووه‌.",
                "is_active": true
            }
        ],
