    {
        "id": 6126,
        "ayah_number": 1,
        "text_uthmani": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةِ ٱلْقَدْرِ",
        "text_simple": null,
        "page_number": 1234,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12251,
                "language_code": "en",
                "content": "Indeed, We sent it [i.e., the Qur’ān] down during the Night of Decree.",
                "is_active": true
            },
            {
                "id": 12252,
                "language_code": "ku",
                "content": "ئێمه به‌ڕاستی قورئانمان دابه‌زاندۆته خواره‌وه له شه‌وێکی به‌فه‌ڕو ڕێزداردا.",
                "is_active": true
            }
