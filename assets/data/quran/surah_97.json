    {
        "id": 6128,
        "ayah_number": 3,
        "text_uthmani": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ",
        "text_simple": null,
        "page_number": 1234,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12255,
                "language_code": "en",
                "content": "The Night of Decree is better than a thousand months.",
                "is_active": true
            },
            {
                "id": 12256,
                "language_code": "ku",
                "content": "شه‌وی قه‌دری به‌ڕێز له هه‌زار مانگ ڕێزدارو خێردارتره (واته پاداشتی عیباده‌ت و خواپه‌رستی ئه‌و شه‌وه بێ سنووره‌).",
                "is_active": true
            }
        ],
