    {
        "id": 6129,
        "ayah_number": 4,
        "text_uthmani": "تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ",
        "text_simple": null,
        "page_number": 1234,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12257,
                "language_code": "en",
                "content": "The angels and the Spirit [i.e., Gabriel] descend therein by permission of their Lord for every matter.<sup foot_note=197788>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12258,
                "language_code": "ku",
                "content": "له‌و شه‌وه‌دا فریشته‌کان که جوبره‌ئیلیشیان له‌گه‌ڵدایه‌، داده‌به‌زن له‌سه‌ر ڕووخسه‌ت و مۆڵه‌تی په‌روه‌ردگاریان، به‌جۆره‌ها فرمان و کار (به‌تایبه‌ت بۆ سه‌ردانی خواپه‌رستان، بۆ سه‌ردانی مزگه‌وته‌کان، بۆ گوێگرتن له قورئان و... هتد).",
                "is_active": true
            }
        ],
