    {
        "id": 6127,
        "ayah_number": 2,
        "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ",
        "text_simple": null,
        "page_number": 1234,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12253,
                "language_code": "en",
                "content": "And what can make you know what is the Night of Decree?",
                "is_active": true
            },
            {
                "id": 12254,
                "language_code": "ku",
                "content": "جا تۆ چووزانی شه‌وی به‌فه‌ڕ کامه‌یه‌و چ خێرو به‌ره‌که‌تێکه‌.",
                "is_active": true
            }
        ],
