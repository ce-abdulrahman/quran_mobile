    {
        "id": 6,
        "ayah_number": 6,
        "text_uthmani": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
        "text_simple": null,
        "page_number": 1,
        "juz_number": 1,
        "hizb_number": 1,
        "rub_number": 1,
        "translations": [
            {
                "id": 11,
                "language_code": "en",
                "content": "Guide us to the straight path -",
                "is_active": true
            },
            {
                "id": 12,
                "language_code": "ku",
                "content": "خوایه به‌رده‌وام ڕێنمووییمان بفه‌رموو بۆ ئه‌م ڕێبازی ڕاست و دروستی ئیسلامه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 14,
                "end_index": 15,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            },
            {
                "start_index": 31,
                "end_index": 32,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": true,
                "text_segment": "ي"
            },
            {
                "start_index": 32,
                "end_index": 34,
                "rule_id": 8,
                "color_id": 4,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "مَ"
            }
        ]
    },
    {
        "id": 7,
        "ayah_number": 7,
        "text_uthmani": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
        "text_simple": null,
        "page_number": 1,
        "juz_number": 1,
        "hizb_number": 1,
        "rub_number": 1,
        "translations": [
            {
                "id": 13,
                "language_code": "en",
                "content": "The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.",
                "is_active": true
            },
            {
                "id": 14,
                "language_code": "ku",
                "content": "که به‌رنامه و ڕێبازی ئه‌وانه‌یه له نازو نیعمه‌تی خۆت به‌هره‌وه‌رت کردوون، نه‌مانخه‌یته سه‌ر ڕێبازی ئه‌وانه‌ی خه‌شم و قینیان لێگیراوه (به‌هۆی ئه‌وه‌وه ده‌یزانن و لایانداوه‌)، هه‌روه‌ها نه‌مانخاته سه‌ر ڕێبازی ئه‌وانه‌ش، که سه‌رگه‌ردان و گومڕان (به‌هۆی لاساری و یاخی بوون و نه‌زانینیانه‌وه‌)",
                "is_active": true
            }
        ],
