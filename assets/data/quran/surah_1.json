[
    {
        "id": 1,
        "ayah_number": 1,
        "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
        "text_simple": null,
        "page_number": 1,
        "juz_number": 1,
        "hizb_number": 1,
        "rub_number": 1,
        "translations": [
            {
                "id": 1,
                "language_code": "en",
                "content": "In the name of Allāh,<sup foot_note=195932>1<\/sup> the Entirely Merciful, the Especially Merciful.<sup foot_note=195931>2<\/sup>",
                "is_active": true
            },
            {
                "id": 2,
                "language_code": "ku",
                "content": "به ناوی خوای به‌خشنده‌ی میهره‌بان (به ناوی ئه‌و خوایه‌ی كانگای ڕه‌حمه‌ت و سۆزو به‌زه‌ییه‌).",
                "is_active": true
            }
        ],
