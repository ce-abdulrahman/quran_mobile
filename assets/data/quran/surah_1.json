    {
        "id": 2,
        "ayah_number": 2,
        "text_uthmani": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
        "text_simple": null,
        "page_number": 1,
        "juz_number": 1,
        "hizb_number": 1,
        "rub_number": 1,
        "translations": [
            {
                "id": 3,
                "language_code": "en",
                "content": "[All] praise is [due] to Allāh, Lord<sup foot_note=195933>1<\/sup> of the worlds -",
                "is_active": true
            },
            {
                "id": 4,
                "language_code": "ku",
                "content": "‌سوپاس و ستایش هه‌ر شایسته‌ی خوایه و بۆ خوایه‌، که خاوه‌ن و په‌روه‌ردگاری هه‌موو جیهانیان و هه‌موو بوونه‌وه‌ره.",
                "is_active": true
            }
        ],
