    {
        "id": 4,
        "ayah_number": 4,
        "text_uthmani": "مَـٰلِكِ يَوْمِ ٱلدِّينِ",
        "text_simple": null,
        "page_number": 1,
        "juz_number": 1,
        "hizb_number": 1,
        "rub_number": 1,
        "translations": [
            {
                "id": 7,
                "language_code": "en",
                "content": "Sovereign of the Day of Recompense.<sup foot_note=195934>1<\/sup>",
                "is_active": true
            },
            {
                "id": 8,
                "language_code": "ku",
                "content": "خاوه‌ن و سه‌رداری ڕۆژی پاداشت و سزایه (پادشای ڕۆژی قیامه‌ته که دادپه‌روه‌ری ڕه‌هاو بێ سنووری تێدا به‌رپا ده‌کات).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 13,
                "end_index": 15,
                "rule_id": 8,
                "color_id": 4,
                "connects_to_left": true,
