    },
    {
        "id": 5,
        "ayah_number": 5,
        "text_uthmani": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
        "text_simple": null,
        "page_number": 1,
        "juz_number": 1,
        "hizb_number": 1,
        "rub_number": 1,
        "translations": [
            {
                "id": 9,
                "language_code": "en",
                "content": "It is You we worship and You we ask for help.",
                "is_active": true
            },
            {
                "id": 10,
                "language_code": "ku",
                "content": "خوایه‌، ته‌نها هه‌ر تۆ ده‌په‌رستین و هه‌ر له‌تۆش داوای یارمه‌تی و پشتیوانی ده‌که‌ین (له کاروباری دین و دنیاماندا، به‌که‌سی تر له به‌ده‌کانت ناکرێت).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
