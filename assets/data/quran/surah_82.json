                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 5833,
        "ayah_number": 4,
        "text_uthmani": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
        "text_simple": null,
        "page_number": 1163,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11665,
                "language_code": "en",
                "content": "And when the [contents of] graves are scattered [i.e., exposed],",
                "is_active": true
            },
            {
                "id": 11666,
                "language_code": "ku",
                "content": "کاتێك که گۆره‌کان ژێره و ژوور ده‌کرێن (مردووه‌کانی ناویان ده‌هێنرێنه ده‌ره‌وه و زیندوو ده‌کرێنه‌وه‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
