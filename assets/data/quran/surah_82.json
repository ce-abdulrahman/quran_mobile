    },
    {
        "id": 5834,
        "ayah_number": 5,
        "text_uthmani": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
        "text_simple": null,
        "page_number": 1163,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11667,
                "language_code": "en",
                "content": "A soul will [then] know what it has put forth and kept back.",
                "is_active": true
            },
            {
                "id": 11668,
                "language_code": "ku",
                "content": "ئه‌وسا هه‌رکه‌س ده‌زانێت چی پێشخستووه و چی دواخستووه‌، چی ده‌ستپێشکه‌ری کردووه و چیشی هێشتۆته‌وه (له کارو کرده‌وه‌ی چاك، یان خراپ که خه‌ڵکی دوای خۆی چاویان لێ کردووه‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 13,
                "end_index": 15,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "سٌ"
            },
