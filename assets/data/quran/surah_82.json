    },
    {
        "id": 5831,
        "ayah_number": 2,
        "text_uthmani": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
        "text_simple": null,
        "page_number": 1163,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11661,
                "language_code": "en",
                "content": "And when the stars fall, scattering,",
                "is_active": true
            },
            {
                "id": 11662,
                "language_code": "ku",
                "content": "کاتێك ئه‌ستێره و هه‌ساره‌کان په‌رش و بلاو ده‌بنه‌وه و ورد و خاش ده‌بن.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 27,
                "end_index": 28,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 5832,
        "ayah_number": 3,
        "text_uthmani": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
        "text_simple": null,
        "page_number": 1163,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11663,
                "language_code": "en",
                "content": "And when the seas are erupted",
                "is_active": true
            },
            {
                "id": 11664,
                "language_code": "ku",
                "content": "کاتێك ده‌ریاکان ده‌ته‌قێنرێنه‌وه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 16,
                "end_index": 17,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": false,
