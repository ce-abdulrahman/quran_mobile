    {
        "id": 5830,
        "ayah_number": 1,
        "text_uthmani": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
        "text_simple": null,
        "page_number": 1163,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11659,
                "language_code": "en",
                "content": "When the sky breaks apart",
                "is_active": true
            },
            {
                "id": 11660,
                "language_code": "ku",
                "content": "کاتێك ئاسمان له‌ت له‌ت و پارچه پارچه ده‌بێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
