    {
        "id": 5838,
        "ayah_number": 9,
        "text_uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
        "text_simple": null,
        "page_number": 1164,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11675,
                "language_code": "en",
                "content": "No! But you deny the Recompense.",
                "is_active": true
            },
            {
                "id": 11676,
                "language_code": "ku",
                "content": "واز بهێنن له بێ ئاگایی، (نه‌ده‌بوو وابێت به‌رامبه‌ر ئه‌و په‌روه‌ردگاره جوانکاره‌ت، سه‌ره‌ڕای ئه‌و هه‌موو ڕوون کردنه‌وانه‌) به‌ڵکو بڕوا به‌ڕۆژی پاداشت ناکه‌ن!!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
