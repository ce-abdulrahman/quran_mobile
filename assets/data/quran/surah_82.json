                "end_index": 39,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 5835,
        "ayah_number": 6,
        "text_uthmani": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
        "text_simple": null,
        "page_number": 1164,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11669,
                "language_code": "en",
                "content": "O mankind, what has deceived you concerning your Lord, the Generous,",
                "is_active": true
            },
            {
                "id": 11670,
                "language_code": "ku",
                "content": "ئه‌ی ئینسان!! تۆ چی وای لێکردویت که سه‌رکه‌ش بیت به‌رامبه‌ر په‌روه‌ردگاری میهره‌بان و به‌ڕێزت؟ چی وای لێکردویت که وه‌کو پێویست قه‌دری نه‌زانیت؟ (نافه‌رمان و یاخی بیت؟).",
                "is_active": true
            }
        ],
