    {
        "id": 5836,
        "ayah_number": 7,
        "text_uthmani": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
        "text_simple": null,
        "page_number": 1164,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11671,
                "language_code": "en",
                "content": "Who created you, proportioned you, and balanced you?",
                "is_active": true
            },
            {
                "id": 11672,
                "language_code": "ku",
                "content": "(به‌مه‌رجێك) ئه‌و په‌روه‌ردگاره تۆی دروست کردووه‌، به ڕێكوپێکترین شێوه‌، به‌جوانترین شێواز (ئه‌ندامه‌کان هه‌موو له‌شوێنی تایبه‌تی خۆیاندا دانراون که بتوانن کارو فرنانی خۆیان به‌چاکی ئه‌نجام بده‌ن و ئه‌و ئه‌ندامانه‌ش که جووتن قه‌باره و درێژی و شێوه‌یان چوونیه‌که‌، جگه له‌وه‌ی که یارمه‌تی و ته‌باییه‌کی ته‌واو هه‌یه له‌نێوانیاندا و هه‌مووان هاوکارن).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5837,
        "ayah_number": 8,
        "text_uthmani": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
        "text_simple": null,
        "page_number": 1164,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11673,
                "language_code": "en",
                "content": "In whatever form He willed has He assembled you.",
