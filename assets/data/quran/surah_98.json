    {
        "id": 6137,
        "ayah_number": 7,
        "text_uthmani": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ",
        "text_simple": null,
        "page_number": 1237,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12273,
                "language_code": "en",
                "content": "Indeed, they who have believed and done righteous deeds - those are the best of creatures.",
                "is_active": true
            },
            {
                "id": 12274,
                "language_code": "ku",
                "content": "بێگومان ئه‌وانه‌ی ئیمان و باوه‌ڕیان هێناوه‌و کارو کرده‌وه چاکه‌کانیان ئه‌نجامداوه‌، هه‌ر ئه‌وانه‌ن چاکترین و پاکترینی خه‌ڵکانی سه‌ر زه‌وی.",
                "is_active": true
            }
        ],
