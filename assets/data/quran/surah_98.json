    {
        "id": 6132,
        "ayah_number": 2,
        "text_uthmani": "رَسُولٌ مِّنَ ٱللَّهِ يَتْلُوا۟ صُحُفًا مُّطَهَّرَةً",
        "text_simple": null,
        "page_number": 1236,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12263,
                "language_code": "en",
                "content": "A Messenger from Allāh, reciting purified<sup foot_note=197791>1<\/sup> scriptures",
                "is_active": true
            },
            {
                "id": 12264,
                "language_code": "ku",
                "content": "(ئه‌ویش) پێغه‌مبه‌رێکه له‌لایه‌ن خواوه کتێب و نامه‌ی پاك و بێگه‌ردیان به‌سه‌ردا ده‌خوێنێته‌وه (که قورئانه‌).",
