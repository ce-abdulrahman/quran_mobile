    {
        "id": 6133,
        "ayah_number": 3,
        "text_uthmani": "فِيهَا كُتُبٌ قَيِّمَةٌ",
        "text_simple": null,
        "page_number": 1236,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12265,
                "language_code": "en",
                "content": "Within which are correct writings [i.e., rulings and laws].",
                "is_active": true
            },
            {
                "id": 12266,
                "language_code": "ku",
                "content": "چه‌نده‌ها په‌یامی پڕ له ڕێنموویی به نرخی له توێدا هه‌یه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 11,
                "end_index": 13,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "بٌ"
            }
        ]
    },
    {
        "id": 6134,
        "ayah_number": 4,
        "text_uthmani": "وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ",
        "text_simple": null,
        "page_number": 1236,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12267,
                "language_code": "en",
                "content": "Nor did those who were given the Scripture become divided<sup foot_note=197792>1<\/sup> until after there had come to them clear evidence.",
                "is_active": true
            },
            {
                "id": 12268,
                "language_code": "ku",
                "content": "جا خاوه‌ن کتێبه‌کان ده‌سته ده‌سته‌و پارچه پارچه نه‌بوون، دوای ئه‌وه نه‌بێت که به‌ڵگه‌و نیشانه‌ی ئاشکرایان بۆ هات (ده‌رباره‌ی پێغه‌مبه‌رو قورئان).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 10,
                "end_index": 11,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
