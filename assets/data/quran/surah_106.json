        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12389,
                "language_code": "en",
                "content": "Their accustomed security [in] the caravan of winter and summer<sup foot_note=197821>1<\/sup> -",
                "is_active": true
            },
            {
                "id": 12390,
                "language_code": "ku",
                "content": "خوی گرتووه به کاروانی زستانه‌ی (یه‌مه‌ن)و کاروانی هاوینه‌ی (شام) بۆ بازرگانی و (دابین کردنی بژێوی).",
