    {
        "id": 6197,
        "ayah_number": 4,
        "text_uthmani": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
        "text_simple": null,
        "page_number": 1254,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12393,
                "language_code": "en",
                "content": "Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.",
                "is_active": true
            },
            {
                "id": 12394,
                "language_code": "ku",
                "content": "ئه‌و زاته‌ی له‌برسێتی ڕزگاری کردن و خۆراکی پێبه‌خشین و له ترس و بیمی (جه‌رده و ڕێگران) پاڕاستوونی و ئاسایشی بۆ دابین کردوون.",
                "is_active": true
            }
        ],
