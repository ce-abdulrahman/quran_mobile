                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 6037,
        "ayah_number": 14,
        "text_uthmani": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
        "text_simple": null,
        "page_number": 1211,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12073,
                "language_code": "en",
                "content": "Or feeding on a day of severe hunger",
                "is_active": true
            },
            {
                "id": 12074,
                "language_code": "ku",
                "content": "یاخود خۆراک به‌خشینه له ڕۆژێکدا که گرانی و پرسێتی هه‌بێت.",
                "is_active": true
            }
        ],
