    },
    {
        "id": 6033,
        "ayah_number": 10,
        "text_uthmani": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
        "text_simple": null,
        "page_number": 1210,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12065,
                "language_code": "en",
                "content": "And have shown him the two ways?<sup foot_note=197765>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12066,
                "language_code": "ku",
                "content": "ئایا به منداڵی ڕێنموویمان نه‌کردووه بۆ ئه‌وه‌ی شیر له مه‌مکه‌کانی دایکی بخوات؟، له گه‌وره‌یشدا بۆ ئه‌وه‌ی سه‌رپشک بێت له شوێنکه‌وتنی ڕێبازی ڕاست، یان چه‌وت؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 12,
                "end_index": 13,
                "rule_id": 11,
                "color_id": 6,
                "connects_to_left": true,
