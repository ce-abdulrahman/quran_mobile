        "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
        "text_simple": null,
        "page_number": 1211,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12069,
                "language_code": "en",
                "content": "And what can make you know what is [breaking through] the difficult pass?",
                "is_active": true
            },
            {
                "id": 12070,
                "language_code": "ku",
                "content": "جا تۆ ‎چووزانی ئه‌و کۆسپ و له‌مپه‌رانه کامه‌ن؟!...",
                "is_active": true
            }
        ],
