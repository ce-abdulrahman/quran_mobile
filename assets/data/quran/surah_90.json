    {
        "id": 6034,
        "ayah_number": 11,
        "text_uthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
        "text_simple": null,
        "page_number": 1211,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12067,
                "language_code": "en",
                "content": "But he has not broken through the difficult pass.<sup foot_note=197766>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12068,
                "language_code": "ku",
                "content": "که‌چی (زۆربه‌ی ئه‌و خه‌ڵکه‌) نه‌یتوانی به‌سه‌ر کۆسپ و له‌په‌ره‌کاندا زاڵ ببێت و ڕێگای سه‌رفه‌رزای بگرێته‌به‌ر.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 7,
                "end_index": 9,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": false,
                "connects_to_right": true,
                "text_segment": "قْ"
            },
            {
