    },
    {
        "id": 6027,
        "ayah_number": 4,
        "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
        "text_simple": null,
        "page_number": 1209,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12053,
                "language_code": "en",
                "content": "We have certainly created man into hardship.",
                "is_active": true
            },
            {
                "id": 12054,
                "language_code": "ku",
                "content": "(سوێند به‌وانه‌) به‌ڕاستی ئێمه ئینسانمان دروست کردووه و به‌رده‌وام له ناڕه‌حه‌تی و سه‌غڵه‌تی و کێشه و ناخۆشیدا..",
                "is_active": true
            }
        ],
