    {
        "id": 6025,
        "ayah_number": 2,
        "text_uthmani": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
        "text_simple": null,
        "page_number": 1209,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12049,
                "language_code": "en",
                "content": "And you, [O Muḥammad], are free of restriction in this city",
                "is_active": true
            },
            {
                "id": 12050,
                "language_code": "ku",
                "content": "له کاتێکدا تۆ نیشته‌جێی تیایدا.",
                "is_active": true
            }
        ],
