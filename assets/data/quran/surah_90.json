    {
        "id": 6031,
        "ayah_number": 8,
        "text_uthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
        "text_simple": null,
        "page_number": 1210,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12061,
                "language_code": "en",
                "content": "Have We not made for him two eyes?",
                "is_active": true
            },
            {
                "id": 12062,
                "language_code": "ku",
                "content": "ئایا جووتێک چاومان پێنه‌به‌خشیووه‌؟ (‎چاو: زۆر گرنگتره له دوو ده‌زگای کامێرای ئه‌له‌کترۆنی خودکار له هه‌ر چرکه‌یه‌کدا هه‌زاران وێنه‌ی ڕه‌نگاو ڕه‌نگ ده‌گرێت و ده‌ینێرێت بۆ مێشک، ئه‌ویش هه‌ندێکی هه‌ڵده‌گرێت).",
                "is_active": true
            }
        ],
