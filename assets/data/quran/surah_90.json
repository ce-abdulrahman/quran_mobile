        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12083,
                "language_code": "en",
                "content": "But they who disbelieved in Our signs - those are the companions of the left.<sup foot_note=197768>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12084,
                "language_code": "ku",
                "content": "ئه‌وانه‌ش که باوه‌ڕیان به ئایه‌ت و فه‌رمانه‌کانی ئێمه نه‌بووه‌، ئه‌وانه ده‌سته‌ی خوارو چه‌پ و چه‌وت و ناله‌باران، ده‌سته‌ی نه‌گبه‌ت و سه‌رلێشیواوه‌کانن.",
                "is_active": true
            }
