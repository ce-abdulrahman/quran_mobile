    {
        "id": 6029,
        "ayah_number": 6,
        "text_uthmani": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
        "text_simple": null,
        "page_number": 1210,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12057,
                "language_code": "en",
                "content": "He says, \"I have spent wealth in abundance.\"",
                "is_active": true
            },
            {
                "id": 12058,
                "language_code": "ku",
                "content": "(زۆرجار) ده‌ڵێت: من پاره‌ی زۆرم له ناوداوه‌!! من ماڵی زۆرم خه‌رج کردووه‌!!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 33,
                "end_index": 34,
                "rule_id": 12,
                "color_id": 5,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6030,
        "ayah_number": 7,
        "text_uthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
        "text_simple": null,
        "page_number": 1210,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12059,
                "language_code": "en",
                "content": "Does he think that no one has seen him?",
                "is_active": true
            },
            {
                "id": 12060,
                "language_code": "ku",
                "content": "ئایا وا ده‌زانێت که‌س ئاگاداری نیه‌و نه‌یبینیووه (که ئه‌و سه‌رمایه‌یه‌ی له کوێوه په‌یداکردووه و له چیدا خه‌رجی کردووه‌؟! ‎).",
                "is_active": true
            }
        ],
