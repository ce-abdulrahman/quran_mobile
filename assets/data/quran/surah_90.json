    },
    {
        "id": 6026,
        "ayah_number": 3,
        "text_uthmani": "وَوَالِدٍ وَمَا وَلَدَ",
        "text_simple": null,
        "page_number": 1209,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12051,
                "language_code": "en",
                "content": "And [by] the father<sup foot_note=197764>1<\/sup> and that which was born [of him],",
                "is_active": true
            },
            {
                "id": 12052,
                "language_code": "ku",
                "content": "سوێند به باوک و ڕۆڵه‌که‌ی.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 7,
