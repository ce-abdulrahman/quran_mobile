    {
        "id": 6036,
        "ayah_number": 13,
        "text_uthmani": "فَكُّ رَقَبَةٍ",
        "text_simple": null,
        "page_number": 1211,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12071,
                "language_code": "en",
                "content": "It is the freeing of a slave",
                "is_active": true
            },
            {
                "id": 12072,
                "language_code": "ku",
                "content": "ئازاد؛ ردنی به‌نده و کۆیله‌یه (یان ئازادکردنی گه‌ردنی خۆیه‌تی له گوناهو یاخی بوون و سه‌رکه‌شی).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 6,
                "end_index": 7,
                "rule_id": 1,
