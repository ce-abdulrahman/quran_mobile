    {
        "id": 6032,
        "ayah_number": 9,
        "text_uthmani": "وَلِسَانًا وَشَفَتَيْنِ",
        "text_simple": null,
        "page_number": 1210,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12063,
                "language_code": "en",
                "content": "And a tongue and two lips?",
                "is_active": true
            },
            {
                "id": 12064,
                "language_code": "ku",
                "content": "هه‌روه‌ها زمان و دوو لێوه‌شمان پێ نه‌به‌خشیووه‌؟",
                "is_active": true
            }
        ],
        "tajweed_segments": [
