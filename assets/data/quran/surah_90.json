    {
        "id": 6028,
        "ayah_number": 5,
        "text_uthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
        "text_simple": null,
        "page_number": 1209,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12055,
                "language_code": "en",
                "content": "Does he think that never will anyone overcome him?",
                "is_active": true
            },
            {
                "id": 12056,
                "language_code": "ku",
                "content": "ئایا ئاده‌میزاد واده‌زانێت که هه‌رگیز که‌س ده‌سه‌ڵاتی به‌سه‌ریدا نابێت؟",
