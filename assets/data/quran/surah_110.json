    {
        "id": 6215,
        "ayah_number": 2,
        "text_uthmani": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا",
        "text_simple": null,
        "page_number": 1261,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12428,
                "language_code": "en",
                "content": "And you see the people entering into the religion of Allāh in multitudes,",
                "is_active": true
            },
            {
                "id": 12429,
                "language_code": "ku",
                "content": "خه‌ڵکیشت بینی پۆل پۆل ده‌چنه ڕیزی ئاینی خواوه‌.",
                "is_active": true
            }
        ],
