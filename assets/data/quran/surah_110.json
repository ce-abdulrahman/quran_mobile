    {
        "id": 6216,
        "ayah_number": 3,
        "text_uthmani": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا",
        "text_simple": null,
        "page_number": 1262,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12430,
                "language_code": "en",
                "content": "Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of Repentance.<sup foot_note=197826>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12431,
                "language_code": "ku",
                "content": "ئه‌وسا ئیتر تۆ سوپاس و ستایشی په‌روه‌ردگارت بکه و داوای لێ خۆش بوونی لێ بکه‌، چونکه به‌ڕاستی خوا زۆر چاوپۆشی ده‌کات و تۆبه وه‌رگره (.. ئومێده له ئاینده‌یه‌کی نزیکدا، خوای باڵاده‌ست سه‌رکه‌وتنێک ببه‌خشێت، ئه‌و کاته ئیمانداران هه‌ست ده‌که‌ن ئه‌م سوره‌ته تازه دابه‌زیوه‌).",
                "is_active": true
            }
        ],
