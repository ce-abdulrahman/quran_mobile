[
    {
        "id": 6214,
        "ayah_number": 1,
        "text_uthmani": "إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ",
        "text_simple": null,
        "page_number": 1261,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12426,
                "language_code": "en",
                "content": "When the victory of Allāh has come and the conquest,<sup foot_note=197825>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12427,
                "language_code": "ku",
                "content": "کاتێ یارمه‌تی و کۆمه‌کی خوا دێت، شاری مه‌ککه ڕزگار ده‌کرێت و ده‌رگای ئازادی واڵا ده‌کرێت.",
                "is_active": true
            }
        ],
