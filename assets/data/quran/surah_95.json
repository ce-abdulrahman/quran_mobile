    {
        "id": 6101,
        "ayah_number": 3,
        "text_uthmani": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
        "text_simple": null,
        "page_number": 1228,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12201,
                "language_code": "en",
                "content": "And [by] this secure city [i.e., Makkah],",
                "is_active": true
            },
            {
                "id": 12202,
                "language_code": "ku",
                "content": "سوێند به‌م شاره ئه‌مینه‌، که (مه‌ککه‌) یه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 27,
                "end_index": 28,
                "rule_id": 4,
                "color_id": 2,
