        "id": 6099,
        "ayah_number": 1,
        "text_uthmani": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ",
        "text_simple": null,
        "page_number": 1228,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12197,
                "language_code": "en",
                "content": "By the fig and the olive<sup foot_note=197782>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12198,
                "language_code": "ku",
                "content": "سوێند به هه‌نجیرو زه‌یتوون (که دوو میوه‌ی به‌سوودو به‌که‌ڵکن، سوێند خواردنی خوا به دروستکراوانی بۆ سه‌رنج ڕاکێشانمانه‌، به‌ڵام سوێند خواردنی ئێمه گه‌وره‌یی و گرنگی سوێند پێ خۆراوه‌که ده‌گه‌یه‌نێت).",
                "is_active": true
            }
        ],
