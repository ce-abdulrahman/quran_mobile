    {
        "id": 6105,
        "ayah_number": 7,
        "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
        "text_simple": null,
        "page_number": 1229,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12209,
                "language_code": "en",
                "content": "So what yet causes you to deny the Recompense?<sup foot_note=197785>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12210,
                "language_code": "ku",
                "content": "جا ئیتر (ئه‌ی ئینسانی سه‌ر که‌ش) چی وای لێکردوویت باوه‌ڕت به‌ڕۆژی قیامه‌ت و لێپرسینه‌وه نه‌بێت دوای ئه‌و هه‌موو نازو نیعمه‌ته‌؟",
                "is_active": true
            }
        ],
        "tajweed_segments": [
