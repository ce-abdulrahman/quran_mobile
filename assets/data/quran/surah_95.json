    {
        "id": 6103,
        "ayah_number": 5,
        "text_uthmani": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ",
        "text_simple": null,
        "page_number": 1228,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12205,
                "language_code": "en",
                "content": "Then We return him to the lowest of the low,<sup foot_note=197784>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12206,
                "language_code": "ku",
                "content": "(ئه‌گه‌ر ڕێبازی خواناسی نه‌گرێت) سه‌ره‌نجام ده‌یخه‌ینه نزمترینی شوێنه نزمه‌کانه‌وه (له دۆزه‌خدا).",
                "is_active": true
