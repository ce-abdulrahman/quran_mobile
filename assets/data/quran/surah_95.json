    {
        "id": 6104,
        "ayah_number": 6,
        "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",
        "text_simple": null,
        "page_number": 1229,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12207,
                "language_code": "en",
                "content": "Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.",
                "is_active": true
            },
            {
                "id": 12208,
                "language_code": "ku",
                "content": "جگه له‌وانه‌ی که باوه‌ڕیان هێناوه‌و کارو کرده‌وه چاکه‌کانیان ئه‌نجامداوه‌، پاداشتی هه‌میشه‌و نه‌بڕاوه بۆیان ئاماده‌یه‌.",
                "is_active": true
            }
        ],
