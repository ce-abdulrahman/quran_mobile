    {
        "id": 6106,
        "ayah_number": 8,
        "text_uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",
        "text_simple": null,
        "page_number": 1229,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12211,
                "language_code": "en",
                "content": "Is not Allāh the most just of judges?",
                "is_active": true
            },
            {
                "id": 12212,
                "language_code": "ku",
                "content": "ئایا خوا چاکترین فه‌رمانڕه‌وا نیه‌؟ دادپه‌روه‌رترین فه‌رمانڕه‌وا نیه‌؟ (که‌چی تۆی سه‌ر که‌ش پێی ڕازیی نیت!!).",
                "is_active": true
            }
        ],
