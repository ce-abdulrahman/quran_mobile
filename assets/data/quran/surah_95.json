    {
        "id": 6102,
        "ayah_number": 4,
        "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ",
        "text_simple": null,
        "page_number": 1228,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12203,
                "language_code": "en",
                "content": "We have certainly created man in the best of stature;<sup foot_note=197783>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12204,
                "language_code": "ku",
                "content": "به‌ڕاستی ئێمه ئینسانمان له جوانترین شێوه و ڕێکوپێکترین شێوازدا دروست کردووه له هه‌موو ڕوویه‌که‌وه‌.",
                "is_active": true
            }
        ],
