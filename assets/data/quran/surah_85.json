    {
        "id": 5916,
        "ayah_number": 7,
        "text_uthmani": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ",
        "text_simple": null,
        "page_number": 1183,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11831,
                "language_code": "en",
                "content": "And they, to what they were doing against the believers, were witnesses. <sup foot_note=197741>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11832,
                "language_code": "ku",
                "content": "له نزیکه‌وه چاودێری ئه‌و کاره‌ساته‌یان ده‌کرد که به‌سه‌ر باوه‌ڕداراندا ده‌هێنرێت و خۆیان له نزیکه‌وه سه‌رپه‌رشتیان ده‌کرد.",
                "is_active": true
