        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11825,
                "language_code": "en",
                "content": "Destroyed [i.e., cursed] were the companions of the trench<sup foot_note=197740>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11826,
                "language_code": "ku",
                "content": "به‌کوشت چن، نه‌فرینیان لێ بێت، ئه‌وانه‌ی که چاڵیان هه‌ڵکه‌ند (بۆ ئیمانداران)...",
