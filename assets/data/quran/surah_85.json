    {
        "id": 5918,
        "ayah_number": 9,
        "text_uthmani": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ",
        "text_simple": null,
        "page_number": 1183,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11835,
                "language_code": "en",
                "content": "To whom belongs the dominion of the heavens and the earth. And Allāh, over all things, is Witness.<sup foot_note=197742>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11836,
                "language_code": "ku",
                "content": "ئه‌و زاته‌ی که خاوه‌نی هه‌موو شتێکه له ئاسمانه‌کان و زه‌ویدا، ئه‌و خوایه‌ی شایه‌ته له‌سه‌ر هه‌موو شتێك و ئاگای له هه‌موو شتێكه‌.",
                "is_active": true
            }
        ],
