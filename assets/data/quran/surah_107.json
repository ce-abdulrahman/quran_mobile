                "text_segment": "مَ"
            }
        ]
    },
    {
        "id": 6200,
        "ayah_number": 3,
        "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
        "text_simple": null,
        "page_number": 1255,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12399,
                "language_code": "en",
                "content": "And does not encourage the feeding of the poor.",
                "is_active": true
            },
            {
                "id": 12400,
                "language_code": "ku",
                "content": "هانی که‌سیش نادات تا خواردن و خۆراك ببه‌خشێت به هه‌ژارو نه‌داران.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
