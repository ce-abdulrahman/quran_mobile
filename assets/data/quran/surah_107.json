        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12395,
                "language_code": "en",
                "content": "Have you seen the one who denies the Recompense?",
                "is_active": true
            },
            {
                "id": 12396,
                "language_code": "ku",
                "content": "ئایا سه‌رنجت نه‌داوه له‌و که‌سه‌ی ئاینی خوا به درۆ ده‌زانێت؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
