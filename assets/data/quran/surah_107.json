    {
        "id": 6199,
        "ayah_number": 2,
        "text_uthmani": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
        "text_simple": null,
        "page_number": 1255,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12397,
                "language_code": "en",
                "content": "For that is the one who drives away the orphan",
                "is_active": true
            },
            {
                "id": 12398,
                "language_code": "ku",
                "content": "که‌وابوو ئه‌و جۆره که‌سه ئه‌وه‌یه که پاڵ به هه‌تیوه‌وه ده‌نێت و پیایدا هه‌ڵده‌شاخێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 33,
                "end_index": 34,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
