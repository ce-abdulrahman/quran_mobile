    },
    {
        "id": 6201,
        "ayah_number": 4,
        "text_uthmani": "فَوَيْلٌ لِّلْمُصَلِّينَ",
        "text_simple": null,
        "page_number": 1255,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12401,
                "language_code": "en",
                "content": "So woe to those who pray",
                "is_active": true
            },
            {
                "id": 12402,
                "language_code": "ku",
                "content": "جا هاوارو واوه‌یلا بۆ نوێژگه‌رانێك...",
                "is_active": true
            }
        ],
        "tajweed_segments": [
