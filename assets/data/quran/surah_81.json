[
    {
        "id": 5801,
        "ayah_number": 1,
        "text_uthmani": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
        "text_simple": null,
        "page_number": 1157,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11601,
                "language_code": "en",
                "content": "When the sun is wrapped up [in darkness]",
                "is_active": true
            },
            {
                "id": 11602,
                "language_code": "ku",
                "content": "کاتێك خۆر ده‌پێچرێته‌وه و ڕووناکی نامێنێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5802,
        "ayah_number": 2,
        "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
        "text_simple": null,
        "page_number": 1157,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11603,
                "language_code": "en",
                "content": "And when the stars fall, dispersing,",
                "is_active": true
            },
            {
                "id": 11604,
                "language_code": "ku",
                "content": "کاتێکیش ئه‌ستێره‌کان (له خو‌لگه‌ی خۆیان) ده‌ترازێن و ده‌ده‌ن به‌یه‌کدا.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5803,
        "ayah_number": 3,
        "text_uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
        "text_simple": null,
        "page_number": 1157,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11605,
                "language_code": "en",
                "content": "And when the mountains are removed",
                "is_active": true
            },
            {
                "id": 11606,
                "language_code": "ku",
                "content": "کاتێك کێوه‌کان له شوێنی خۆیان هه‌ڵده‌که‌نرێن و به‌ملاولادا ده‌برێن.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5804,
        "ayah_number": 4,
        "text_uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
        "text_simple": null,
        "page_number": 1157,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11607,
                "language_code": "en",
                "content": "And when full-term she-camels<sup foot_note=197714>1<\/sup> are neglected",
                "is_active": true
            },
            {
                "id": 11608,
                "language_code": "ku",
                "content": "کا‌تێك حوشترانی ئاوس که ته‌مه‌نی باردارییان ده مانگه گوێیان پێنادرێت (بێگومان ئه‌و وشترانه لای عه‌ره‌ب زۆر نازدارن).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5805,
        "ayah_number": 5,
        "text_uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
        "text_simple": null,
        "page_number": 1157,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11609,
                "language_code": "en",
                "content": "And when the wild beasts are gathered",
                "is_active": true
            },
            {
                "id": 11610,
                "language_code": "ku",
                "content": "کاتێك گیانله‌به‌رانی کێوی و وه‌حشی و دڕنده به ده‌وری یه‌کدا کۆده‌کرێنه‌وه (ئه‌وانیش دڕندایه‌تی خۆیانیان له بیر ده‌چێته‌وه له سامناکی ئه‌و ڕۆژه‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5806,
        "ayah_number": 6,
        "text_uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
        "text_simple": null,
        "page_number": 1158,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11611,
                "language_code": "en",
                "content": "And when the seas are filled with flame<sup foot_note=197715>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11612,
                "language_code": "ku",
                "content": "کاتێك ده‌ریاکان گڕ ده‌درێن (دیاره که ته‌قینه‌وه‌ی ئه‌تۆمی ڕووده‌دات و ئاوی ده‌ریاکان ده‌بنه‌وه به هایدرۆجین و ئۆکسجین).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5807,
        "ayah_number": 7,
        "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
        "text_simple": null,
        "page_number": 1158,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11613,
                "language_code": "en",
                "content": "And when the souls are paired<sup foot_note=197716>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11614,
                "language_code": "ku",
                "content": "کاتێك گیانی هه‌ر که‌س ده‌گه‌رێته‌وه بۆ لاشه‌ی و جووت ده‌بێته‌وه له‌گه‌ڵیدا.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5808,
        "ayah_number": 8,
        "text_uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
        "text_simple": null,
        "page_number": 1158,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11615,
                "language_code": "en",
                "content": "And when the girl [who was] buried alive is asked",
                "is_active": true
            },
            {
                "id": 11616,
                "language_code": "ku",
                "content": "کاتێك کچی زینده به‌چاڵکراو پرسیاری لێده‌کرێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5809,
        "ayah_number": 9,
        "text_uthmani": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
        "text_simple": null,
        "page_number": 1158,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11617,
                "language_code": "en",
                "content": "For what sin she was killed",
                "is_active": true
            },
            {
                "id": 11618,
                "language_code": "ku",
                "content": "به چ گوناهێك، به چ تۆمه‌تێك کوژرا؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5810,
        "ayah_number": 10,
        "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
        "text_simple": null,
        "page_number": 1158,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11619,
                "language_code": "en",
                "content": "And when the pages<sup foot_note=197717>1<\/sup> are spread [i.e., made public]",
                "is_active": true
            },
            {
                "id": 11620,
                "language_code": "ku",
                "content": "کاتێك نامه‌ی کرده‌وه‌کان واڵا ده‌کرێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5811,
        "ayah_number": 11,
        "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
        "text_simple": null,
        "page_number": 1159,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11621,
                "language_code": "en",
                "content": "And when the sky is stripped away",
                "is_active": true
            },
            {
                "id": 11622,
                "language_code": "ku",
                "content": "کاتێك ئاسمان لاده‌برێن و داده‌ماڵرێن.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5812,
        "ayah_number": 12,
        "text_uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
        "text_simple": null,
        "page_number": 1159,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11623,
                "language_code": "en",
                "content": "And when Hellfire is set ablaze",
                "is_active": true
            },
            {
                "id": 11624,
                "language_code": "ku",
                "content": "کاتێك دۆزه‌خ داده‌گیرسێت و تاوده‌درێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5813,
        "ayah_number": 13,
        "text_uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
        "text_simple": null,
        "page_number": 1159,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11625,
                "language_code": "en",
                "content": "And when Paradise is brought near,",
                "is_active": true
            },
            {
                "id": 11626,
                "language_code": "ku",
                "content": "کاتێك به‌‌هه‌شت نزیك ده‌خرێته‌وه (له خواناسان).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5814,
        "ayah_number": 14,
        "text_uthmani": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
        "text_simple": null,
        "page_number": 1159,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11627,
                "language_code": "en",
                "content": "A soul will [then] know what it has brought [with it].<sup foot_note=197718>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11628,
                "language_code": "ku",
                "content": "ئیتر ئه‌و کاته هه‌رکه‌س ده‌زانێت چی ئاماده کردووه و چ توێشوویه‌کی پێیه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5815,
        "ayah_number": 15,
        "text_uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
        "text_simple": null,
        "page_number": 1159,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11629,
                "language_code": "en",
                "content": "So I swear by the retreating stars -",
                "is_active": true
            },
            {
                "id": 11630,
                "language_code": "ku",
                "content": "سوێند به‌و ئه‌ستێرانه‌ی که په‌نهان ده‌بن و ون ده‌بن له‌چاو، یاخود به‌هۆی سوڕانه‌وه‌ی زه‌وی و خۆیانه‌وه (به‌هۆی هه‌ڵهاتنی خۆره‌وه‌) ون ده‌بن.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5816,
        "ayah_number": 16,
        "text_uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
        "text_simple": null,
        "page_number": 1160,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11631,
                "language_code": "en",
                "content": "Those that run [their courses] and disappear [i.e., set]",
                "is_active": true
            },
            {
                "id": 11632,
                "language_code": "ku",
                "content": "به‌و هه‌سارانه‌ی که په‌نا ده‌گرن و دیار نامێنن.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5817,
        "ayah_number": 17,
        "text_uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
        "text_simple": null,
        "page_number": 1160,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11633,
                "language_code": "en",
                "content": "And by the night as it closes in<sup foot_note=197719>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11634,
                "language_code": "ku",
                "content": "به‌و شه‌وه‌ی که دادێت و تاریکایه‌که‌ی ڕوومان تێده‌کات.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5818,
        "ayah_number": 18,
        "text_uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
        "text_simple": null,
        "page_number": 1160,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11635,
                "language_code": "en",
                "content": "And by the dawn when it breathes [i.e., stirs]",
                "is_active": true
            },
            {
                "id": 11636,
                "language_code": "ku",
                "content": "به به‌ره‌به‌یان که پشووی تێدێت، وه‌کو زینده‌وه‌رێك ئاهی تێدێته‌وه و ده‌ست ده‌کات به هه‌ناسه‌دان و ژیان و ڕووناکیه‌که‌ی ده‌رده‌که‌وێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5819,
        "ayah_number": 19,
        "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
        "text_simple": null,
        "page_number": 1160,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11637,
                "language_code": "en",
                "content": "[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]",
                "is_active": true
            },
            {
                "id": 11638,
                "language_code": "ku",
                "content": "(سوێند به‌وانه هه‌مووی) به‌ڕاستی، بێ دوودڵی ئه‌م قورئانه له‌زاری نێردراوێکی به‌ڕێزه‌وه‌یه (که جوبره‌ئیله‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5820,
        "ayah_number": 20,
        "text_uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
        "text_simple": null,
        "page_number": 1160,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11639,
                "language_code": "en",
                "content": "[Who is] possessed of power and with the Owner of the Throne, secure [in position],",
                "is_active": true
            },
            {
                "id": 11640,
                "language_code": "ku",
                "content": "خاوه‌نی هێزو ده‌سه‌ڵاته و لای خاوه‌نی عه‌رش، فریشته‌یه‌کی پایه‌داره‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5821,
        "ayah_number": 21,
        "text_uthmani": "مُّطَاعٍ ثَمَّ أَمِينٍ",
        "text_simple": null,
        "page_number": 1161,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11641,
                "language_code": "en",
                "content": "Obeyed there [in the heavens] and trustworthy.",
                "is_active": true
            },
            {
                "id": 11642,
                "language_code": "ku",
                "content": "فه‌رمانڕه‌وایه له‌وێ، هه‌روه‌ها ئه‌مین و دڵسۆزه له کاره‌کانیدا.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5822,
        "ayah_number": 22,
        "text_uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
        "text_simple": null,
        "page_number": 1161,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11643,
                "language_code": "en",
                "content": "And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.<sup foot_note=197720>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11644,
                "language_code": "ku",
                "content": "دڵنیابن که هاورێکه‌تان { محمد (صلی الله علیه وسلم) } شێت نیه و (له‌که‌ماڵی ژیریدایه‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5823,
        "ayah_number": 23,
        "text_uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
        "text_simple": null,
        "page_number": 1161,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11645,
                "language_code": "en",
                "content": "And he has already seen him [i.e., Gabriel] in the clear horizon.<sup foot_note=197721>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11646,
                "language_code": "ku",
                "content": "بێگومان محمد (صلی الله علیه وسلم) جوبره‌ئیلی بینی به ئاشکرا له ئاسۆی نومایاندا.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5824,
        "ayah_number": 24,
        "text_uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
        "text_simple": null,
        "page_number": 1161,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11647,
                "language_code": "en",
                "content": "And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.<sup foot_note=197722>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11648,
                "language_code": "ku",
                "content": "هه‌رچی پێ ده‌گات، له جیهانی نهێنی و شاراوه‌کانه‌وه‌، لێتان ناشارێته‌وه و ڕاستیتان پێ ڕاده‌گه‌یه‌نێت چونکه هه‌رگیز له گه‌یاندنی په‌یامه‌که‌یدا ڕژدو ڕه‌زیل نیه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5825,
        "ayah_number": 25,
        "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
        "text_simple": null,
        "page_number": 1161,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11649,
                "language_code": "en",
                "content": "And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].",
                "is_active": true
            },
            {
                "id": 11650,
                "language_code": "ku",
                "content": "ئه‌م قورئانه گوفتاری شه‌یتانی نه‌فرین لێکراو نیه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5826,
        "ayah_number": 26,
        "text_uthmani": "فَأَيْنَ تَذْهَبُونَ",
        "text_simple": null,
        "page_number": 1162,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11651,
                "language_code": "en",
                "content": "So where are you going?<sup foot_note=197723>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11652,
                "language_code": "ku",
                "content": "ئیتر بۆ کوێ ده‌چن؟ ڕوو ده‌که‌نه کوێ؟ ڕوو ده‌که‌نه کێ؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5827,
        "ayah_number": 27,
        "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
        "text_simple": null,
        "page_number": 1162,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11653,
                "language_code": "en",
                "content": "It is not except a reminder to the worlds",
                "is_active": true
            },
            {
                "id": 11654,
                "language_code": "ku",
                "content": "ئه‌م قورئانه ته‌نها یادخه‌ره‌وه‌یه بۆ سه‌رجه‌م دانیشتووانی زه‌وی (بۆ په‌ری و ئاده‌میزاد له هه‌موو سه‌رده‌مه‌کاندا).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5828,
        "ayah_number": 28,
        "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
        "text_simple": null,
        "page_number": 1162,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11655,
                "language_code": "en",
                "content": "For whoever wills among you to take a right course.",
                "is_active": true
            },
            {
                "id": 11656,
                "language_code": "ku",
                "content": "بۆ ئه‌وانه‌تان که ده‌یانه‌وێت ڕێبازی ڕاست و دروست بگرنه‌به‌ر.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5829,
        "ayah_number": 29,
        "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
        "text_simple": null,
        "page_number": 1162,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11657,
                "language_code": "en",
                "content": "And you do not will except that Allāh wills - Lord of the worlds.",
                "is_active": true
            },
            {
                "id": 11658,
                "language_code": "ku",
                "content": "ویستی ئێوه‌ش نایه‌ته دێته دی مه‌گه‌ر کاتێك خوای په‌روه‌ردگاری جیهانیان بیه‌وێت، (هه‌رکه‌س ویستی خێری هه‌بێت خوای گه‌وره سه‌ربه‌رستی لێ زه‌وت ناکات، له‌گه‌ڵ ئه‌وه‌شدا هه‌ر ئه‌وه پێش دێت که ویستی خوای له‌سه‌ره و توانای تێگه‌یشتنمان له نهێنی و شاراوه‌کا‌ن زۆر سنوورداره‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    }
]