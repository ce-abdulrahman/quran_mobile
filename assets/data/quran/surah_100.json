    {
        "id": 6155,
        "ayah_number": 9,
        "text_uthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
        "text_simple": null,
        "page_number": 1241,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12309,
                "language_code": "en",
                "content": "But does he not know that when the contents of the graves are scattered",
                "is_active": true
            },
            {
                "id": 12310,
                "language_code": "ku",
                "content": "ئایا ئه‌و جۆره که‌سانه نازانن چی پێش دێت کاتێك له گۆڕه‌کان هێنرانه ده‌ره‌وه‌و (زیندوو کرانه‌وه‌)؟!",
                "is_active": true
            }
        ],
