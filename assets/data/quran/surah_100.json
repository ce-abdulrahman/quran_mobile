    {
        "id": 6152,
        "ayah_number": 6,
        "text_uthmani": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
        "text_simple": null,
        "page_number": 1241,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12303,
                "language_code": "en",
                "content": "Indeed mankind, to his Lord, is ungrateful.",
                "is_active": true
            },
            {
                "id": 12304,
                "language_code": "ku",
                "content": "سوێند به‌وانه هه‌مووی، به‌ڕاستی ئاده‌میزاد له ئاستی په‌روه‌ردگاریدا زۆر ناسوپاس و حه‌ق نه‌ناسه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
