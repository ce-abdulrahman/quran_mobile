    {
        "id": 6156,
        "ayah_number": 10,
        "text_uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
        "text_simple": null,
        "page_number": 1241,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12311,
                "language_code": "en",
                "content": "And that within the breasts is obtained,<sup foot_note=197802>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12312,
                "language_code": "ku",
                "content": "هه‌رچیش له سینه‌کاندا هه‌یه هه‌ر هه‌مووی له (کارنامه‌کاندا) به تۆمار کراوی ئاشکرا کران و خرانه به‌رده‌ست!!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
