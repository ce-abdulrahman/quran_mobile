    {
        "id": 6153,
        "ayah_number": 7,
        "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
        "text_simple": null,
        "page_number": 1241,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12305,
                "language_code": "en",
                "content": "And indeed, he is to that a witness.<sup foot_note=197801>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12306,
                "language_code": "ku",
                "content": "خۆیشی شایه‌ته له‌سه‌ر ئه‌و حاڵه‌ی خۆی، (ڕۆژی قیامه‌ت دان به که‌مته‌ر خه‌می خۆیدا ده‌نێت).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
