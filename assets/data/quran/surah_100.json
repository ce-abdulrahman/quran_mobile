        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12301,
                "language_code": "en",
                "content": "Arriving thereby in the center<sup foot_note=197800>1<\/sup> collectively,",
                "is_active": true
            },
            {
                "id": 12302,
                "language_code": "ku",
                "content": "له‌و کاته‌دا خۆیان ده‌که‌ن به‌ناو جه‌رگه‌ی دوژمناندا.",
