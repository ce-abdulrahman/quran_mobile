    {
        "id": 6154,
        "ayah_number": 8,
        "text_uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
        "text_simple": null,
        "page_number": 1241,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12307,
                "language_code": "en",
                "content": "And indeed he is, in love of wealth, intense.",
                "is_active": true
            },
            {
                "id": 12308,
                "language_code": "ku",
                "content": "بێگومان ئاده‌میزاد له خۆشه‌ویستی ساماندا زۆر به‌تین و هه‌ڵپه‌یه (که ده‌ستی لێی گیربوو ڕه‌زیل و ڕژد و چرووکه‌).",
                "is_active": true
            }
        ],
