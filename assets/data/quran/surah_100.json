        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12313,
                "language_code": "en",
                "content": "Indeed, their Lord with them, that Day, is [fully] Aware.<sup foot_note=197803>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12314,
                "language_code": "ku",
                "content": "به‌ڕاستی په‌روه‌ردگاریان له‌و ڕۆژه‌دا ئاگادارو شاره‌زایه پێیان (به‌وردی ده‌پرسێته‌وه‌).",
                "is_active": true
