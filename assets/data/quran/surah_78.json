[
    {
        "id": 5673,
        "ayah_number": 1,
        "text_uthmani": "عَمَّ يَتَسَآءَلُونَ",
        "text_simple": null,
        "page_number": 1130,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11345,
                "language_code": "en",
                "content": "About what are they asking one another?",
                "is_active": true
            },
            {
                "id": 11346,
                "language_code": "ku",
                "content": "(ئه‌ی خه‌ڵکه‌) ده‌رباره‌ی چی له یه‌کتر ده‌پرسن؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5674,
        "ayah_number": 2,
        "text_uthmani": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
        "text_simple": null,
        "page_number": 1130,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11347,
                "language_code": "en",
                "content": "About the great news<sup foot_note=197673>1<\/sup> -",
                "is_active": true
            },
            {
                "id": 11348,
                "language_code": "ku",
                "content": "ده‌رباره‌ی هه‌واڵه گه‌وره و گرنگه‌که‌!! (که ڕۆژی قیامه‌ته‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5675,
        "ayah_number": 3,
        "text_uthmani": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
        "text_simple": null,
        "page_number": 1130,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11349,
                "language_code": "en",
                "content": "That over which they are in disagreement.",
                "is_active": true
            },
            {
                "id": 11350,
                "language_code": "ku",
                "content": "له حاڵێکدا له ئه‌وانه ڕاو بۆچوونیان جیاوازه ده‌رباره‌ی.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5676,
        "ayah_number": 4,
        "text_uthmani": "كَلَّا سَيَعْلَمُونَ",
        "text_simple": null,
        "page_number": 1130,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11351,
                "language_code": "en",
                "content": "No! They are going to know.",
                "is_active": true
            },
            {
                "id": 11352,
                "language_code": "ku",
                "content": "نه‌خێر، وا بۆیان نالوێت، له داهاتوویه‌کی نزیکدا خۆیان ده‌بیننه‌وه و هه‌موو ڕاستیه‌کانیان بۆ ده‌رده‌که‌وێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5677,
        "ayah_number": 5,
        "text_uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
        "text_simple": null,
        "page_number": 1130,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11353,
                "language_code": "en",
                "content": "Then, no! They are going to know.",
                "is_active": true
            },
            {
                "id": 11354,
                "language_code": "ku",
                "content": "به‌ڵێ! له‌وه‌و دوا، له داهاتوویه‌کی نزیکدا خۆیان ده‌بیننه‌وه و ڕاستیه‌کانیان بۆ ده‌رده‌که‌وێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5678,
        "ayah_number": 6,
        "text_uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
        "text_simple": null,
        "page_number": 1131,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11355,
                "language_code": "en",
                "content": "Have We not made the earth a resting place?",
                "is_active": true
            },
            {
                "id": 11356,
                "language_code": "ku",
                "content": "(پێش باسی قیامه‌ت په‌روه‌ردگار گه‌شتێکیان به ناو دروستکراوه‌کان و دیارده‌کاندا پێده‌کات ده‌پرسێت: ئایا زه‌ویمان وه‌ک لانکه بۆ فه‌راهه‌نگ نه‌هێناون؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5679,
        "ayah_number": 7,
        "text_uthmani": "وَٱلْجِبَالَ أَوْتَادًا",
        "text_simple": null,
        "page_number": 1131,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11357,
                "language_code": "en",
                "content": "And the mountains as stakes?<sup foot_note=197674>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11358,
                "language_code": "ku",
                "content": "(ئایا) کێوه‌کانمان وه‌ک مێخ بۆ دانه‌کوتاون؟ (تا زه‌وی بپارێزێت له فشاری بورکان و ماده تواوه‌کانی ناو ناخی، هه‌روه‌رها هه‌تا له‌نگه‌ری ڕابگرێت و چه‌نده‌ها سودی ترتان پێ بگه‌یه‌نێت).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5680,
        "ayah_number": 8,
        "text_uthmani": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
        "text_simple": null,
        "page_number": 1131,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11359,
                "language_code": "en",
                "content": "And We created you in pairs.",
                "is_active": true
            },
            {
                "id": 11360,
                "language_code": "ku",
                "content": "(ئایا) نێوه‌مان به جووت دروست نه‌کردووه‌؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5681,
        "ayah_number": 9,
        "text_uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
        "text_simple": null,
        "page_number": 1131,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11361,
                "language_code": "en",
                "content": "And made your sleep [a means for] rest",
                "is_active": true
            },
            {
                "id": 11362,
                "language_code": "ku",
                "content": "خه‌وتنمان بۆ نه‌کردوون به‌هۆی سره‌وتن؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5682,
        "ayah_number": 10,
        "text_uthmani": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
        "text_simple": null,
        "page_number": 1131,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11363,
                "language_code": "en",
                "content": "And made the night as clothing<sup foot_note=197675>1<\/sup>.",
                "is_active": true
            },
            {
                "id": 11364,
                "language_code": "ku",
                "content": "(ئایا) شه‌وگارمان بۆ نه‌کردوون به‌داپۆشه‌ر وه‌ک پۆشاک، تاتیایدا بشاردرێنه‌وه‌؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5683,
        "ayah_number": 11,
        "text_uthmani": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
        "text_simple": null,
        "page_number": 1132,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11365,
                "language_code": "en",
                "content": "And made the day for livelihood.",
                "is_active": true
            },
            {
                "id": 11366,
                "language_code": "ku",
                "content": "(ئایا) ڕۆژیشمان بۆ نه‌کردوونه‌ته کاتی به ده‌ستهێنانی ڕزق و ڕۆزی؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5684,
        "ayah_number": 12,
        "text_uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
        "text_simple": null,
        "page_number": 1132,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11367,
                "language_code": "en",
                "content": "And constructed above you seven strong [heavens].",
                "is_active": true
            },
            {
                "id": 11368,
                "language_code": "ku",
                "content": "(ئایا) حه‌وت چین ئاسمانی به هێز و پته‌ومان به ڕا سه‌رتانه‌وه دروست نه‌کردووه‌؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5685,
        "ayah_number": 13,
        "text_uthmani": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
        "text_simple": null,
        "page_number": 1132,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11369,
                "language_code": "en",
                "content": "And made [therein] a burning lamp",
                "is_active": true
            },
            {
                "id": 11370,
                "language_code": "ku",
                "content": "چرایه‌کی پرشنگدارمان بۆ فه‌راهه‌م نه‌هێناون؟ (که مه‌به‌ست خۆره‌)",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5686,
        "ayah_number": 14,
        "text_uthmani": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
        "text_simple": null,
        "page_number": 1132,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11371,
                "language_code": "en",
                "content": "And sent down, from the rain clouds, pouring water.",
                "is_active": true
            },
            {
                "id": 11372,
                "language_code": "ku",
                "content": "‎ (ئایا) له هه‌وره گوشراوه‌کان بارانێکی زۆرمان نه‌باراندووه‌؟",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5687,
        "ayah_number": 15,
        "text_uthmani": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
        "text_simple": null,
        "page_number": 1132,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11373,
                "language_code": "en",
                "content": "That We may bring forth thereby grain and vegetation.",
                "is_active": true
            },
            {
                "id": 11374,
                "language_code": "ku",
                "content": "تا به هۆی ئه‌و بارانه‌وه جۆره‌ها دانه‌وێڵه و ڕووه‌ک بڕوێنین.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5688,
        "ayah_number": 16,
        "text_uthmani": "وَجَنَّـٰتٍ أَلْفَافًا",
        "text_simple": null,
        "page_number": 1133,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11375,
                "language_code": "en",
                "content": "And gardens of entwined growth.",
                "is_active": true
            },
            {
                "id": 11376,
                "language_code": "ku",
                "content": "هه‌روه‌ها چه‌نده‌ها باخی چڕو پڕو له‌یه‌ک ئاڵاو به‌دی نه‌هێناوه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5689,
        "ayah_number": 17,
        "text_uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا",
        "text_simple": null,
        "page_number": 1133,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11377,
                "language_code": "en",
                "content": "Indeed, the Day of Judgement is an appointed time -",
                "is_active": true
            },
            {
                "id": 11378,
                "language_code": "ku",
                "content": "(ئینجا دێته سه‌ر باسی هه‌واڵه گرنگ و سامناکه‌که‌): به‌‎ڕاستی ڕۆژی جیاکرنه‌وه‌، کاتێكیدیاری کراوه (بۆ جیاکردنه‌وه‌ی چاکان له خراپان، ئیمانداران له کافران، سته‌مکاران له سته‌ملێکراوان).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5690,
        "ayah_number": 18,
        "text_uthmani": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
        "text_simple": null,
        "page_number": 1133,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11379,
                "language_code": "en",
                "content": "The Day the Horn is blown and you will come forth in multitudes",
                "is_active": true
            },
            {
                "id": 11380,
                "language_code": "ku",
                "content": "ئه‌و ڕۆژه‌ی که فوو ده‌کرێت به (صور) دا، جا پۆل پۆل و ده‌سته ده‌سته به‌ره‌و مه‌یدانی لێپرسینه‌وه بێ په‌روا دێن.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5691,
        "ayah_number": 19,
        "text_uthmani": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
        "text_simple": null,
        "page_number": 1133,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11381,
                "language_code": "en",
                "content": "And the heaven is opened and will become gateways.",
                "is_active": true
            },
            {
                "id": 11382,
                "language_code": "ku",
                "content": "ئاسمان ده‌کرێته‌وه و ده‌بێته ده‌روازه و ده‌رگا (بۆ دابه‌زینی فریشته‌کان).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5692,
        "ayah_number": 20,
        "text_uthmani": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
        "text_simple": null,
        "page_number": 1133,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11383,
                "language_code": "en",
                "content": "And the mountains are removed and will be [but] a mirage.",
                "is_active": true
            },
            {
                "id": 11384,
                "language_code": "ku",
                "content": "کێوه‌کانیش هه‌ڵده‌که‌نرێن و ده‌ڕۆن به ئاسماندا وه‌ک تراویلکه و سه‌رابێکی گه‌وره‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5693,
        "ayah_number": 21,
        "text_uthmani": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
        "text_simple": null,
        "page_number": 1134,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11385,
                "language_code": "en",
                "content": "Indeed, Hell has been lying in wait",
                "is_active": true
            },
            {
                "id": 11386,
                "language_code": "ku",
                "content": "بێگومان دۆزه‌خیش ده‌مێکه چاوه‌ڕێی ئه‌و ڕۆژه‌یه و خۆی بۆ مه‌ڵاسداوه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5694,
        "ayah_number": 22,
        "text_uthmani": "لِّلطَّـٰغِينَ مَـَٔابًا",
        "text_simple": null,
        "page_number": 1134,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11387,
                "language_code": "en",
                "content": "For the transgressors, a place of return,",
                "is_active": true
            },
            {
                "id": 11388,
                "language_code": "ku",
                "content": "ده‌بێته مه‌نزڵگای خوانه‌ناس و یاخیه‌کان.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5695,
        "ayah_number": 23,
        "text_uthmani": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا",
        "text_simple": null,
        "page_number": 1134,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11389,
                "language_code": "en",
                "content": "In which they will remain for ages [unending].",
                "is_active": true
            },
            {
                "id": 11390,
                "language_code": "ku",
                "content": "هه‌زاره‌ها ساڵی دوورو درێژ و نه‌بڕاوه‌ی تێدا ده‌به‌نه‌سه‌ر...",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5696,
        "ayah_number": 24,
        "text_uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
        "text_simple": null,
        "page_number": 1134,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11391,
                "language_code": "en",
                "content": "They will not taste therein [any] coolness or drink.",
                "is_active": true
            },
            {
                "id": 11392,
                "language_code": "ku",
                "content": "له‌ناویدا ناچێژن فێنکاییه‌ک، یا خواردنه‌وه‌یه‌کی به‌تام...",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5697,
        "ayah_number": 25,
        "text_uthmani": "إِلَّا حَمِيمًا وَغَسَّاقًا",
        "text_simple": null,
        "page_number": 1134,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11393,
                "language_code": "en",
                "content": "Except scalding water and [foul] purulence -",
                "is_active": true
            },
            {
                "id": 11394,
                "language_code": "ku",
                "content": "جگه له ئاوی له کوڵ و کێم و زووخاو.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5698,
        "ayah_number": 26,
        "text_uthmani": "جَزَآءً وِفَاقًا",
        "text_simple": null,
        "page_number": 1135,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11395,
                "language_code": "en",
                "content": "An appropriate recompense.<sup foot_note=197676>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11396,
                "language_code": "ku",
                "content": "که ئه‌وه‌ش پاداشتێكی له‌بارو پڕاو پڕه (بۆ خوانه‌ناسان).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5699,
        "ayah_number": 27,
        "text_uthmani": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
        "text_simple": null,
        "page_number": 1135,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11397,
                "language_code": "en",
                "content": "Indeed, they were not expecting an account",
                "is_active": true
            },
            {
                "id": 11398,
                "language_code": "ku",
                "content": "چونکه ئه‌وانه کاتی خۆی به‌ته‌مای ئه‌م ڕۆژه و لێپرسینه‌وه‌یه نه‌بوون، حه‌زیان له باسی نه‌ده‌کرد.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5700,
        "ayah_number": 28,
        "text_uthmani": "وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا",
        "text_simple": null,
        "page_number": 1135,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11399,
                "language_code": "en",
                "content": "And denied Our verses with [emphatic] denial.",
                "is_active": true
            },
            {
                "id": 11400,
                "language_code": "ku",
                "content": "به‌ڵکو زۆر به‌توندی دژایه‌تی ئایه‌ته‌کانی ئێمه‌یان ده‌رکرد و به درۆیان ده‌زانی..",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5701,
        "ayah_number": 29,
        "text_uthmani": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا",
        "text_simple": null,
        "page_number": 1135,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11401,
                "language_code": "en",
                "content": "But all things We have enumerated in writing.",
                "is_active": true
            },
            {
                "id": 11402,
                "language_code": "ku",
                "content": "ئێمه‌ش هه‌موو شتێکمان له‌سه‌ریان سه‌رژمێری کردووه و به‌وردیی تۆمارمان کردووه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5702,
        "ayah_number": 30,
        "text_uthmani": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
        "text_simple": null,
        "page_number": 1135,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11403,
                "language_code": "en",
                "content": "\"So taste [the penalty], and never will We increase you except in torment.\"<sup foot_note=197677>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11404,
                "language_code": "ku",
                "content": "(پاشان پێیان ده‌وترێت) ده بچێژن (ئه‌ی خوانه‌ناسان) له سزاو ئازار و ئه‌شکه‌نجه به‌ولاوه‌، جا هه‌رگیز هیچی ترتان بۆ زیاد ناکه‌ین.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5703,
        "ayah_number": 31,
        "text_uthmani": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
        "text_simple": null,
        "page_number": 1136,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11405,
                "language_code": "en",
                "content": "Indeed, for the righteous is attainment<sup foot_note=197678>1<\/sup> -",
                "is_active": true
            },
            {
                "id": 11406,
                "language_code": "ku",
                "content": "به‌ڕاستی بۆ خواناس و پارێزکاران سه‌رفرازی و خۆشێ و شادی و کامه‌رانی فراوان ئاماده‌یه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5704,
        "ayah_number": 32,
        "text_uthmani": "حَدَآئِقَ وَأَعْنَـٰبًا",
        "text_simple": null,
        "page_number": 1136,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11407,
                "language_code": "en",
                "content": "Gardens and grapevines.",
                "is_active": true
            },
            {
                "id": 11408,
                "language_code": "ku",
                "content": "چه‌نده‌ها باخچه‌ی جوان و جۆری ترێ.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5705,
        "ayah_number": 33,
        "text_uthmani": "وَكَوَاعِبَ أَتْرَابًا",
        "text_simple": null,
        "page_number": 1136,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11409,
                "language_code": "en",
                "content": "And full-breasted [companions] of equal age.",
                "is_active": true
            },
            {
                "id": 11410,
                "language_code": "ku",
                "content": "(له‌و جێگه و ڕێگه خۆشانه‌دا هاوسه‌ر و هاوده‌می) ئافره‌تانی سینه جوان و (دیمه جوان) هاوته‌مه‌ن ئاماده‌یه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5706,
        "ayah_number": 34,
        "text_uthmani": "وَكَأْسًا دِهَاقًا",
        "text_simple": null,
        "page_number": 1136,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11411,
                "language_code": "en",
                "content": "And a full cup.<sup foot_note=197679>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11412,
                "language_code": "ku",
                "content": "له‌گه‌ڵ کاسه‌ی پڕ له شه‌رابی تایبه‌تیدا.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5707,
        "ayah_number": 35,
        "text_uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
        "text_simple": null,
        "page_number": 1136,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11413,
                "language_code": "en",
                "content": "No ill speech will they hear therein or any falsehood -",
                "is_active": true
            },
            {
                "id": 11414,
                "language_code": "ku",
                "content": "له‌و به‌هه‌شته‌دا هیچ جۆره قسه‌یه‌کی پڕو پووچ و درۆ و ده‌له‌سه‌یه‌ک نابیستن.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5708,
        "ayah_number": 36,
        "text_uthmani": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
        "text_simple": null,
        "page_number": 1137,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11415,
                "language_code": "en",
                "content": "[As] reward from your Lord, [a generous] gift [made due by] account,<sup foot_note=197680>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11416,
                "language_code": "ku",
                "content": "ئه‌مه‌ش هه‌مووی پاداشتێکه له‌لایه‌ن په‌روه‌ردگارته‌وه (ئه‌ی ئیماندار)، به‌خششێکه به حسابێکی ورد ده‌به‌خشرێت (به به‌خته‌وه‌ران).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5709,
        "ayah_number": 37,
        "text_uthmani": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
        "text_simple": null,
        "page_number": 1137,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11417,
                "language_code": "en",
                "content": "[From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech.<sup foot_note=197681>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11418,
                "language_code": "ku",
                "content": "‎ (له‌لایه‌ن) په‌روه‌ردگاری میهره‌بانی ئاسمانه‌کان و زه‌وی و هه‌رچی له نێوانیاندا هه‌یه‌، (ئه‌و ڕۆژه‌) که‌س ناتوانێت له‌به‌رده‌م زاتی په‌روه‌ردگاردا بدوێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5710,
        "ayah_number": 38,
        "text_uthmani": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا",
        "text_simple": null,
        "page_number": 1137,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11419,
                "language_code": "en",
                "content": "The Day that the Spirit [i.e., Gabriel] and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.",
                "is_active": true
            },
            {
                "id": 11420,
                "language_code": "ku",
                "content": "ڕۆژێک دێت جوبڕه‌ئیل و فه‌ریشته‌کان به ڕیز ده‌وه‌ستن و ورته‌یان لێنایه‌ت و هیچ قسه ناکه‌ن، مه‌گه‌ر ئه‌وه‌یان که خوای میهره‌بان مۆڵه‌تی بدات و قسه‌ی جوان و به‌جێ پێشکه‌ش بکات.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5711,
        "ayah_number": 39,
        "text_uthmani": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
        "text_simple": null,
        "page_number": 1137,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11421,
                "language_code": "en",
                "content": "That is the True [i.e., certain] Day; so he who wills may take to his Lord a [way of] return.<sup foot_note=197682>1<\/sup>",
                "is_active": true
            },
            {
                "id": 11422,
                "language_code": "ku",
                "content": "ئه‌و ڕۆژه ڕۆژێکی حه‌ق و ڕاسته و به‌ڕێوه‌یه‌.. جا ئه‌وه‌ی ده‌یه‌وێت با به‌ره‌و لای په‌روه‌ردگاری ڕێگه بگرێته به‌ر.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5712,
        "ayah_number": 40,
        "text_uthmani": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
        "text_simple": null,
        "page_number": 1137,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11423,
                "language_code": "en",
                "content": "Indeed, We have warned you of an impending punishment on the Day when a man will observe what his hands have put forth<sup foot_note=197683>1<\/sup> and the disbeliever will say, \"Oh, I wish that I were dust!\"",
                "is_active": true
            },
            {
                "id": 11424,
                "language_code": "ku",
                "content": "به‌ڕاستی ئێمه ئێوه‌مان ئاگادار کردووه له‌وه‌ی که سزایه‌کی نزیک به‌ڕێوه‌یه‌، ئه‌و ڕۆژه ڕۆژێکه که ئاده‌میزاد سه‌یری ده‌ستپێشخه‌ری خۆی ده‌کات، خوانه‌ناسیش ده‌ڵێت.. خۆزگه هه‌ر خاک بوومایه (ئاوا زیندوو نه‌کرامایه‌ته‌وه و گیرم نه‌خواردایه‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    }
]