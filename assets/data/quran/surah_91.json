                "end_index": 23,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6045,
        "ayah_number": 2,
        "text_uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
        "text_simple": null,
        "page_number": 1214,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12089,
                "language_code": "en",
                "content": "And [by] the moon when it follows it",
                "is_active": true
            },
            {
                "id": 12090,
                "language_code": "ku",
                "content": "سوێند به مانگ، کاتێك به‌شوێنیدا دێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 9,
                "end_index": 10,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            },
            {
                "start_index": 26,
                "end_index": 27,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6046,
        "ayah_number": 3,
        "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
        "text_simple": null,
        "page_number": 1214,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12091,
                "language_code": "en",
                "content": "And [by] the day when it displays it<sup foot_note=197770>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12092,
                "language_code": "ku",
                "content": "سوێند به ڕۆژ کاتێک که خۆر ده‌رده‌خات.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 10,
                "end_index": 11,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": false,
                "connects_to_right": false,
                "text_segment": "ر"
            },
            {
                "start_index": 28,
                "end_index": 29,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6047,
        "ayah_number": 4,
        "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
        "text_simple": null,
        "page_number": 1214,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12093,
                "language_code": "en",
                "content": "And [by] the night when it covers [i.e., conceals] it",
                "is_active": true
            },
            {
                "id": 12094,
                "language_code": "ku",
                "content": "سوێند به شه‌و که خۆر داده‌پۆشیت.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 27,
                "end_index": 28,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6048,
        "ayah_number": 5,
        "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
        "text_simple": null,
        "page_number": 1214,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12095,
                "language_code": "en",
                "content": "And [by] the sky and He who constructed it",
                "is_active": true
            },
            {
                "id": 12096,
                "language_code": "ku",
                "content": "سوێند به ئاسمان و به‌و زاته به ده‌سه‌ڵاته‌ی دروستی کردووه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 9,
                "end_index": 10,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            },
            {
                "start_index": 28,
                "end_index": 29,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6049,
        "ayah_number": 6,
        "text_uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
        "text_simple": null,
        "page_number": 1215,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12097,
                "language_code": "en",
                "content": "And [by] the earth and He who spread it",
                "is_active": true
            },
            {
                "id": 12098,
                "language_code": "ku",
                "content": "سوێند به زه‌وی و به‌و زاته‌ی که به‌شێوه‌ی هێلکه‌یی دایناوه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 7,
                "end_index": 9,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": true,
                "text_segment": "رْ"
            },
            {
                "start_index": 26,
                "end_index": 27,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6050,
        "ayah_number": 7,
        "text_uthmani": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
        "text_simple": null,
        "page_number": 1215,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12099,
                "language_code": "en",
                "content": "And [by] the soul and He who proportioned it<sup foot_note=197771>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12100,
                "language_code": "ku",
                "content": "سوێند به ده‌روون و ئه‌و زاته‌ی که به ڕێک و پێکی به‌دیهێناوه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 6,
                "end_index": 8,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "سٍ"
            },
            {
                "start_index": 24,
                "end_index": 25,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6051,
        "ayah_number": 8,
        "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
        "text_simple": null,
        "page_number": 1215,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12101,
                "language_code": "en",
                "content": "And inspired it [with discernment of] its wickedness and its righteousness,",
                "is_active": true
            },
            {
                "id": 12102,
                "language_code": "ku",
                "content": "جا توانای خراپه و چاکه و خوانه‌ناسی و خواناسی تێدا دابین کردووه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 19,
                "end_index": 20,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": false,
                "connects_to_right": false,
                "text_segment": "ر"
            },
            {
                "start_index": 29,
                "end_index": 31,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": true,
                "text_segment": "قْ"
            },
            {
                "start_index": 37,
                "end_index": 38,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6052,
        "ayah_number": 9,
        "text_uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
        "text_simple": null,
        "page_number": 1215,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12103,
                "language_code": "en",
                "content": "He has succeeded who purifies it,",
                "is_active": true
            },
            {
                "id": 12104,
                "language_code": "ku",
                "content": "(سوێند به‌وانه هه‌موو) به‌ڕاستی ئه‌و که‌سه سه‌رفرازه که نه‌فسی پاک و پوخته کردووه و ئیمان و ترسی خوای تیادا ڕواندووه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 2,
                "end_index": 4,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "دْ"
            },
            {
                "start_index": 16,
                "end_index": 17,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ن"
            },
            {
                "start_index": 27,
                "end_index": 28,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6053,
        "ayah_number": 10,
        "text_uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
        "text_simple": null,
        "page_number": 1215,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12105,
                "language_code": "en",
                "content": "And he has failed who instills it [with corruption].",
                "is_active": true
            },
            {
                "id": 12106,
                "language_code": "ku",
                "content": "بێگومان نائومێد بوو ئه‌و که‌سه‌ی نه‌فسی خۆی ناپوخت کرد و ئاڵوده‌ی گوناهو تاوان و خراپه‌ی کرد.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 4,
                "end_index": 6,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "دْ"
            },
            {
                "start_index": 15,
                "end_index": 16,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ن"
            },
            {
                "start_index": 26,
                "end_index": 27,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6054,
        "ayah_number": 11,
        "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
        "text_simple": null,
        "page_number": 1216,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12107,
                "language_code": "en",
                "content": "Thamūd denied [their prophet] by reason of their transgression,",
                "is_active": true
            },
            {
                "id": 12108,
                "language_code": "ku",
                "content": "قه‌ومی ثمود به‌هۆی سه‌رکه‌شی و یاخی بوونیانه‌وه‌، بڕوایان به پێغه‌مبه‌ره‌که‌یان نه‌هێنا.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 30,
                "end_index": 31,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6055,
        "ayah_number": 12,
        "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
        "text_simple": null,
        "page_number": 1216,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12109,
                "language_code": "en",
                "content": "When the most wretched of them was sent forth.<sup foot_note=197772>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12110,
                "language_code": "ku",
                "content": "کاتێک شه‌قاوه و خوانه‌ناسترین که‌سیان خۆیی ڕاپسکاند (بۆ سه‌ربڕینی وشتره‌که‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 25,
                "end_index": 26,
                "rule_id": 4,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6056,
        "ayah_number": 13,
        "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
        "text_simple": null,
        "page_number": 1216,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12111,
                "language_code": "en",
                "content": "And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"",
                "is_active": true
            },
            {
                "id": 12112,
                "language_code": "ku",
                "content": "جا پێغه‌مبه‌ری خوا (صاڵح) پێی وتن: واز بهێنن له‌م وشتره که موعجیزه‌ی خوایه‌، مۆڵه‌تی بده‌ن له نۆره ئاوه‌که‌ی خۆیدا ئاو بخواته‌وه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 12,
                "end_index": 14,
                "rule_id": 8,
                "color_id": 4,
                "connects_to_left": true,
