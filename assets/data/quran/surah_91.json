    {
        "id": 6057,
        "ayah_number": 14,
        "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
        "text_simple": null,
        "page_number": 1216,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12113,
                "language_code": "en",
                "content": "But they denied him and hamstrung<sup foot_note=197773>1<\/sup> her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].",
                "is_active": true
            },
            {
                "id": 12114,
                "language_code": "ku",
                "content": "که‌چی بڕوایان به هه‌ره‌شه‌کانی نه‌کرد، ئینجا وشتره‌که‌یان سه‌ربڕی، ئه‌وسا ئیتر په‌روه‌ردگاریان وڵاتی کاولکردن و له‌گه‌ڵ زه‌ویدا ته‌ختی کرد به‌سه‌ریاندا و که‌سیان ڕزگاری نه‌بوو (به‌هۆی گوناهو تاوانیانه‌وه‌).",
                "is_active": true
            }
        ],
