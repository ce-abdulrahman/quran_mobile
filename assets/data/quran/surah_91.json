    {
        "id": 6058,
        "ayah_number": 15,
        "text_uthmani": "وَلَا يَخَافُ عُقْبَـٰهَا",
        "text_simple": null,
        "page_number": 1217,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12115,
                "language_code": "en",
                "content": "And He does not fear the consequence thereof.<sup foot_note=197774>1<\/sup>",
