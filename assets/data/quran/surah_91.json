[
    {
        "id": 6044,
        "ayah_number": 1,
        "text_uthmani": "وَٱلشَّمْسِ وَضُحَىٰهَا",
        "text_simple": null,
        "page_number": 1214,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12087,
                "language_code": "en",
                "content": "By the sun and its brightness",
                "is_active": true
            },
            {
                "id": 12088,
                "language_code": "ku",
                "content": "سوێند به خۆر و تیشكی خۆراکه له سه‌ره‌تایی ڕۆژدا سه‌رهه‌ڵده‌دا).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 7,
                "end_index": 9,
                "rule_id": 8,
                "color_id": 4,
                "connects_to_left": true,
                "connects_to_right": true,
                "text_segment": "مْ"
            },
