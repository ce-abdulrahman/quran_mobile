    {
        "id": 6219,
        "ayah_number": 3,
        "text_uthmani": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ",
        "text_simple": null,
        "page_number": 1263,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12436,
                "language_code": "en",
