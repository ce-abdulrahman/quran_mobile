[
    {
        "id": 6217,
        "ayah_number": 1,
        "text_uthmani": "تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ",
        "text_simple": null,
        "page_number": 1263,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12432,
                "language_code": "en",
                "content": "May the hands of Abū Lahab be ruined, and ruined is he.<sup foot_note=197827>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12433,
                "language_code": "ku",
                "content": "ده‌سته‌کانی بشکێت ئه‌بو له‌هه‌بو ڕسوا بێت، ئاشکرایه که هه‌ر ڕاسوایش ده‌بێت و‎ (له‌ناو ده‌چێت).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
