    {
        "id": 6218,
        "ayah_number": 2,
        "text_uthmani": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
        "text_simple": null,
        "page_number": 1263,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12434,
                "language_code": "en",
                "content": "His wealth will not avail him or that which he gained.",
                "is_active": true
            },
            {
                "id": 12435,
                "language_code": "ku",
                "content": "ماڵ و دارای و ئه‌و شتانه‌ی که به ده‌ستی هێناوه‌، فریای نه‌که‌وت.",
