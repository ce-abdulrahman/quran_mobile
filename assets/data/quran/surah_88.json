    {
        "id": 5984,
        "ayah_number": 17,
        "text_uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
        "text_simple": null,
        "page_number": 1199,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11967,
                "language_code": "en",
                "content": "Then do they not look at the camels - how they are created?",
                "is_active": true
            },
            {
                "id": 11968,
                "language_code": "ku",
                "content": "(ئینجا خوای دروستکار له ڕوانگه‌ی هه‌ندێك دروستکراوانیه‌وه ده‌یه‌وێت بێ باوه‌ڕان دابچڵه‌کێنێت)، بۆیه ده‌فه‌رموێت: ئایا ئه‌وه سه‌رنجی وشتر ناده‌ن چۆن دروستکراوه‌؟! (قه‌باره‌ی، ملی درێژی، قاچه درێژه‌کانی که به سمێکی ئیسفه‌نجی کۆتایی هاتووه‌، ئینجا خۆگرتنی له‌سه‌ر برسێتی و تینویه‌تی،...)",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 13,
                "end_index": 14,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 5985,
        "ayah_number": 18,
        "text_uthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
        "text_simple": null,
        "page_number": 1199,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11969,
                "language_code": "en",
                "content": "And at the sky - how it is raised?",
                "is_active": true
            },
            {
                "id": 11970,
                "language_code": "ku",
                "content": "ئایا سه‌رنجی ئاسمان ناده‌ن چۆن به‌رزکراوه‌ته‌وه (ئه‌و هه‌موو ئه‌ستێره و کاکه‌شان و هه‌ساره بێ شوماره ده‌وره‌ی زه‌ویداوه له بڵندیه‌وه ڕاگیراون).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 15,
                "end_index": 16,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ا"
            },
