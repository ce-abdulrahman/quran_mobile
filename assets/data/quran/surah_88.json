    {
        "id": 5982,
        "ayah_number": 15,
        "text_uthmani": "وَنَمَارِقُ مَصْفُوفَةٌ",
        "text_simple": null,
        "page_number": 1198,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11963,
                "language_code": "en",
                "content": "And cushions lined up",
                "is_active": true
            },
            {
                "id": 11964,
                "language_code": "ku",
                "content": "هه‌روه‌ها پشتی و سه‌رین و پاڵپشتی جوان و ڕازاوه‌ی تیادایه که به ڕێکو پێکی ڕیزکراون.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
