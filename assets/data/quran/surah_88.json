                "color_id": 1,
                "connects_to_left": false,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 5986,
        "ayah_number": 19,
        "text_uthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
        "text_simple": null,
        "page_number": 1199,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11971,
                "language_code": "en",
                "content": "And at the mountains - how they are erected?",
                "is_active": true
            },
            {
                "id": 11972,
                "language_code": "ku",
                "content": "ئه‌ی سه‌رنجی کێوه‌کان ناده‌ن، چۆن داکوتراون و دامه‌زرێنراون.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 5987,
        "ayah_number": 20,
        "text_uthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
        "text_simple": null,
        "page_number": 1199,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11973,
                "language_code": "en",
                "content": "And at the earth - how it is spread out?",
                "is_active": true
            },
            {
                "id": 11974,
                "language_code": "ku",
                "content": "ئه‌ی سه‌رنجی ده‌شته‌کانی زه‌وی ناده‌ن چۆن ته‌خت کراوه (له‌بار هێنراوه بۆ کشتوکاڵ و ڕێگه‌وبان و ژیان)؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 13,
                "end_index": 15,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": true,
                "text_segment": "رْ"
            }
        ]
    },
    {
        "id": 5988,
        "ayah_number": 21,
        "text_uthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
        "text_simple": null,
        "page_number": 1200,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11975,
                "language_code": "en",
                "content": "So remind, [O Muḥammad]; you are only a reminder.",
                "is_active": true
            },
            {
                "id": 11976,
                "language_code": "ku",
                "content": "که‌واته { تۆ ئه‌ی پێغه‌مبه‌ر (صلی الله علیه وسلم) } ئه‌م شتانه بخه‌ره‌وه یادیان و ئامۆژگاریان بکه‌، به‌ڕاستی تۆ هه‌ر یادخه‌ره‌وه‌یت.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
