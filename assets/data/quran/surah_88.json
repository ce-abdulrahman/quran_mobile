        "text_simple": null,
        "page_number": 1200,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11979,
                "language_code": "en",
                "content": "However, he who turns away and disbelieves",
                "is_active": true
            },
            {
                "id": 11980,
                "language_code": "ku",
                "content": "به‌ڵاو ئه‌و که‌سه‌ی که پشت هه‌ڵکردووه و کوفر هه‌ڵبژاردووه‌...",
                "is_active": true
