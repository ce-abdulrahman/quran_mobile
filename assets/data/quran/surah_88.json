        "text_simple": null,
        "page_number": 1199,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11965,
                "language_code": "en",
                "content": "And carpets spread around.",
                "is_active": true
            },
            {
                "id": 11966,
                "language_code": "ku",
                "content": "فه‌رش و ئۆرته و ڕایه‌خی قه‌شه‌نگ و نه‌خشینی تیادا ڕاخراوه (هه‌موو کۆشک و ته‌لارو ڤێلاکانی پێرازێنراوه‌ته‌وه‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
