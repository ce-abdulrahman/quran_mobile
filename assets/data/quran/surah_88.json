        "text_uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
        "text_simple": null,
        "page_number": 1200,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11977,
                "language_code": "en",
                "content": "You are not over them a controller.",
                "is_active": true
            },
            {
                "id": 11978,
                "language_code": "ku",
                "content": "هیچ ده‌سه‌ڵاتێکت نیه به‌سه‌ر دڵ و ده‌روونیاندا (تا به زۆر باوه‌ڕداریان بکه‌یت).",
