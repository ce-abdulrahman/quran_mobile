        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 11935,
                "language_code": "en",
                "content": "Has there reached you the report of the Overwhelming [event]?",
                "is_active": true
            },
            {
                "id": 11936,
                "language_code": "ku",
                "content": "ئایا هه‌واڵ و ده‌نگوباسی ڕۆژی قیامه‌تت پێگه‌یشتووه‌؟! (ڕۆژێکه سه‌ختیه‌که‌ی هه‌موو که‌سێك داگیر ده‌کات).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
