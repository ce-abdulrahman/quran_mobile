    },
    {
        "id": 6140,
        "ayah_number": 2,
        "text_uthmani": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا",
        "text_simple": null,
        "page_number": 1238,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12279,
                "language_code": "en",
                "content": "And the earth discharges its burdens<sup foot_note=197793>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12280,
                "language_code": "ku",
                "content": "هه‌رچی له زه‌ویدا هه‌بوو له مادده سه‌نگینه‌کانی ناوی ده‌ری په‌ڕاندو هێنایه ده‌ره‌وه‌.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
