        ]
    },
    {
        "id": 6141,
        "ayah_number": 3,
        "text_uthmani": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا",
        "text_simple": null,
        "page_number": 1238,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12281,
                "language_code": "en",
                "content": "And man says,<sup foot_note=197794>1<\/sup> \"What is [wrong] with it?\" -",
                "is_active": true
            },
            {
                "id": 12282,
                "language_code": "ku",
                "content": "(ئه‌و کاته‌) ئاده‌میزادیش ده‌ڵێت: ئه‌وه چیه‌تی، بۆ وای لێهات (ئیماندار هه‌ست ده‌کات کۆتایی دنیایه‌و به‌رپابوونی ڕۆژی قیامه‌ته‌، بێ ئیمانیش سه‌ری لێده‌شێوێت و نازانێت به‌ره‌و کوێ ڕابکات).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 18,
                "end_index": 20,
                "rule_id": 2,
                "color_id": 2,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "نُ"
