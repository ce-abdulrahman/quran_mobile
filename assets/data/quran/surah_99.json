    {
        "id": 6144,
        "ayah_number": 6,
        "text_uthmani": "يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ",
        "text_simple": null,
        "page_number": 1239,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12287,
                "language_code": "en",
                "content": "That Day, the people will depart<sup foot_note=197795>1<\/sup> separated [into categories] to be shown [the result of] their deeds.",
                "is_active": true
            },
            {
                "id": 12288,
                "language_code": "ku",
                "content": "ئه‌و ڕۆژه خه‌ڵکی ده‌سته ده‌سته به‌ره‌و گۆڕه‌پانی لێپرسینه‌وه ده‌رده‌چن، به‌په‌رش و بڵاوی، تا کارو کرده‌وه‌کانیان ببیننه‌وه (دیاره که نامه‌ی کرده‌وه‌کان تۆمار کراوه به‌ده‌نگ و ڕه‌نگه‌وه‌).",
                "is_active": true
            }
        ],
