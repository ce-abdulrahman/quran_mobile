                "connects_to_right": false,
                "text_segment": "ا"
            }
        ]
    },
    {
        "id": 6142,
        "ayah_number": 4,
        "text_uthmani": "يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا",
        "text_simple": null,
        "page_number": 1238,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12283,
                "language_code": "en",
                "content": "That Day, it will report its news",
                "is_active": true
            },
            {
                "id": 12284,
                "language_code": "ku",
                "content": "له‌و ڕۆژه‌دا زه‌وی هه‌واڵه‌کانی خۆی ده‌گێڕێته‌وه‌...",
                "is_active": true
            }
        ],
        "tajweed_segments": [
