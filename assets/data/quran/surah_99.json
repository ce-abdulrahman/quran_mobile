                "is_active": true
            },
            {
                "id": 12290,
                "language_code": "ku",
                "content": "جا ئه‌وه‌ی به‌قه‌ده‌ر سه‌نگی گه‌ردیله‌یه‌ك خێرو چاکه‌ی ئه‌نجام دابێت ده‌یبینێته‌وه‌.",
                "is_active": true
