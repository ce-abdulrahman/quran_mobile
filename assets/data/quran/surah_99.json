[
    {
        "id": 6139,
        "ayah_number": 1,
        "text_uthmani": "إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
        "text_simple": null,
        "page_number": 1238,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12277,
                "language_code": "en",
                "content": "When the earth is shaken with its [final] earthquake",
                "is_active": true
            },
            {
                "id": 12278,
                "language_code": "ku",
                "content": "کاتێك زه‌وی ده‌هێنرێته له‌رزه‌و بوومه‌له‌رزه زۆر به‌هێزه‌که‌ی بۆ پێشهات.",
                "is_active": true
            }
        ],
        "tajweed_segments": [
