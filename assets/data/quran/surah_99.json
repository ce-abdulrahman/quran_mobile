    {
        "id": 6143,
        "ayah_number": 5,
        "text_uthmani": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا",
        "text_simple": null,
        "page_number": 1238,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12285,
                "language_code": "en",
                "content": "Because your Lord has inspired [i.e., commanded] it.",
                "is_active": true
            },
            {
                "id": 12286,
                "language_code": "ku",
                "content": "به‌هۆی ئه‌وه‌ی که په‌روه‌ردگارت ڕایگه‌یاندووه (ئه‌ی ئینسان) فه‌رمانی بۆ ده‌رکردووه (کاتی کۆتایی هاتنیه‌تی).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
