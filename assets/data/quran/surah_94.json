    {
        "id": 6097,
        "ayah_number": 7,
        "text_uthmani": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
        "text_simple": null,
        "page_number": 1227,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12193,
                "language_code": "en",
                "content": "So when you have finished [your duties], then stand up [for worship].",
                "is_active": true
            },
            {
                "id": 12194,
                "language_code": "ku",
                "content": "جا کاتێك له‌کارێکی خێر ده‌بیته‌وه‌، خۆت ماندوو بکه به‌کارێکی خێری تره‌وه‌.",
                "is_active": true
            }
        ],
