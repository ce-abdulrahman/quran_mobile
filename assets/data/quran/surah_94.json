    {
        "id": 6095,
        "ayah_number": 5,
        "text_uthmani": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
        "text_simple": null,
        "page_number": 1226,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12189,
                "language_code": "en",
                "content": "For indeed, with hardship [will be] ease [i.e., relief].",
                "is_active": true
            },
            {
                "id": 12190,
                "language_code": "ku",
                "content": "به‌ڕاستی هاوڕێ له‌گه‌ڵ ته‌نگانه‌دا خۆشی و ئاسووده‌یی دێت.",
