[
    {
        "id": 6091,
        "ayah_number": 1,
        "text_uthmani": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
        "text_simple": null,
        "page_number": 1226,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12181,
                "language_code": "en",
                "content": "Did We not expand for you, [O Muḥammad], your breast?<sup foot_note=197780>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12182,
                "language_code": "ku",
                "content": "(ئه‌ی محمد صلی الله علیه وسلم) ئایا دڵ و ده‌روون و سینه‌مان گوشادو ئاسووده نه‌کردیت؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 4,
                "end_index": 6,
                "rule_id": 8,
                "color_id": 4,
