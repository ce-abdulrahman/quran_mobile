    {
        "id": 6098,
        "ayah_number": 8,
        "text_uthmani": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
        "text_simple": null,
        "page_number": 1227,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12195,
                "language_code": "en",
                "content": "And to your Lord direct [your] longing.",
                "is_active": true
            },
            {
                "id": 12196,
                "language_code": "ku",
                "content": "با هه‌میشه‌و به‌رده‌وام حه‌زو ئاره‌زووت بۆ به‌ده‌ستهێنانی ڕه‌زامه‌ندی خوا بێت، به‌رده‌وام خه‌ڵکیش هان بده تا په‌روه‌ردگارت بناسن و له هه‌وڵی ڕه‌زامه‌ندی ئه‌ودا بن.",
                "is_active": true
            }
        ],
