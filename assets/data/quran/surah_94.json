    {
        "id": 6092,
        "ayah_number": 2,
        "text_uthmani": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
        "text_simple": null,
        "page_number": 1226,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12183,
                "language_code": "en",
                "content": "And We removed from you your burden<sup foot_note=197781>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12184,
                "language_code": "ku",
                "content": "ئایا باری گرانمان له‌سه‌ر شانی تۆ لانه‌برد؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 22,
                "end_index": 23,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 6093,
        "ayah_number": 3,
        "text_uthmani": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
        "text_simple": null,
        "page_number": 1226,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12185,
                "language_code": "en",
                "content": "Which had weighed upon your back",
                "is_active": true
            },
            {
                "id": 12186,
                "language_code": "ku",
                "content": "ئه‌وه‌ی که پشتی تۆی هیلاك و ماندوو کردبوو؟!",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 21,
                "end_index": 22,
                "rule_id": 1,
                "color_id": 1,
                "connects_to_left": true,
                "connects_to_right": false,
                "text_segment": "ر"
            }
        ]
    },
    {
        "id": 6094,
        "ayah_number": 4,
        "text_uthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
        "text_simple": null,
        "page_number": 1226,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12187,
                "language_code": "en",
                "content": "And raised high for you your repute.",
                "is_active": true
            },
            {
                "id": 12188,
                "language_code": "ku",
                "content": "ناوو ناوبانگی تۆمان به‌رزو بڵند نه‌کرده‌وه (له شایه‌تماندا هاوڕێ له‌گه‌ڵ ناوی ئێمه‌دا ناوت ده‌برێت، ناوت له‌سه‌ر زاری فریشته و په‌ری و گرۆی ئاده‌میزاده‌).",
                "is_active": true
            }
        ],
        "tajweed_segments": [
            {
                "start_index": 2,
                "end_index": 3,
                "rule_id": 1,
                "color_id": 1,
