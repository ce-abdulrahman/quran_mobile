[
    {
        "id": 6226,
        "ayah_number": 1,
        "text_uthmani": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
        "text_simple": null,
        "page_number": 1267,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12450,
                "language_code": "en",
                "content": "Say, \"I seek refuge in the Lord of daybreak",
                "is_active": true
            },
            {
                "id": 12451,
                "language_code": "ku",
                "content": "(ئه‌ی محمد (صلی الله علیه وسلم) ئه‌ی ئیماندار) بڵێ: په‌نا ده‌گرم به‌و په‌روه‌ردگاره‌ی که به‌ره‌به‌یان پێش ده‌هێنێت.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 6227,
        "ayah_number": 2,
        "text_uthmani": "مِن شَرِّ مَا خَلَقَ",
        "text_simple": null,
        "page_number": 1267,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12452,
                "language_code": "en",
                "content": "From the evil of that which He created",
                "is_active": true
            },
            {
                "id": 12453,
                "language_code": "ku",
                "content": "له شه‌ڕ و خراپه‌ی هه‌رچی که دروستی کردووه (له په‌ری و ئاده‌میزاد و مار و مێرو).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 6228,
        "ayah_number": 3,
        "text_uthmani": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
        "text_simple": null,
        "page_number": 1267,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12454,
                "language_code": "en",
                "content": "And from the evil of darkness when it settles",
                "is_active": true
            },
            {
                "id": 12455,
                "language_code": "ku",
                "content": "له شه‌ڕ و خراپه‌ی شه‌و کاتێ که دادێت و دنیا تارک ده‌بێت و ده‌بێته شه‌وه‌زه‌نگ.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 6229,
        "ayah_number": 4,
        "text_uthmani": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
        "text_simple": null,
        "page_number": 1267,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12456,
                "language_code": "en",
                "content": "And from the evil of the blowers in knots<sup foot_note=197831>1<\/sup>",
                "is_active": true
            },
            {
                "id": 12457,
                "language_code": "ku",
                "content": "له شه‌ڕ و خراپه‌ی ئه‌و که‌سانه‌ی که جادو ده‌که‌ن و په‌ت و ده‌‌زو گرێ ده‌ده‌ن و فوی پیاده‌که‌ن (به‌فێڵ و جادو نێوانی خه‌ڵکی تێک ده‌ده‌ن).",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    },
    {
        "id": 6230,
        "ayah_number": 5,
        "text_uthmani": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
        "text_simple": null,
        "page_number": 1268,
        "juz_number": 30,
        "hizb_number": 60,
        "rub_number": 237,
        "translations": [
            {
                "id": 12458,
                "language_code": "en",
                "content": "And from the evil of an envier when he envies.\"",
                "is_active": true
            },
            {
                "id": 12459,
                "language_code": "ku",
                "content": "له شه‌ڕ و خراپه‌ی حه‌سود و به‌خیل، کاتێ که حه‌سودی و به‌خیلی ده‌بات.",
                "is_active": true
            }
        ],
        "tajweed_segments": []
    }
]